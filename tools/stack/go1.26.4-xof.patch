+func TestDecResumptionECH(t *testing.T) {
+	for _, id := range []uint16{scheduleTLS13SHAKE256, scheduleTLS13TurboSHAKE256} {
+		for _, ech := range []bool{false, true} {
+			for _, hrr := range []bool{false, true} {
+				t.Run(fmt.Sprintf("%x/ECH=%v/HRR=%v", id, ech, hrr), func(t *testing.T) {
+					client, server := testConfig.Clone(), testConfig.Clone()
+					client.MinVersion, client.MaxVersion = VersionTLS13, VersionTLS13
+					server.MinVersion, server.MaxVersion = VersionTLS13, VersionTLS13
+					client.Rand, server.Rand = rand.Reader, rand.Reader
+					client.Time, server.Time = testTime, testTime
+					client.ServerName = "example.golang"
+					client.scheduleProfiles = []uint16{id}
+					cache := &decSessionCache{t: t, ClientSessionCache: NewLRUClientSessionCache(1), profile: id}
+					client.ClientSessionCache = cache
+					client.SessionTicketsDisabled, server.SessionTicketsDisabled = false, false
+					client.CurvePreferences = []CurveID{X25519, CurveP256}
+					server.CurvePreferences = []CurveID{X25519}
+					if hrr {
+						server.CurvePreferences = []CurveID{CurveP256}
+					}
+					if ech {
+						decECHConfig(t, client, server)
+					}
+					for i := range 3 {
+						ss, cs, err := testHandshake(t, client, server)
+						if err != nil {
+							t.Fatal(err)
+						}
+						if ss.DidResume != (i > 0) || cs.DidResume != (i > 0) {
+							t.Fatalf("handshake %d: resume server=%v client=%v", i, ss.DidResume, cs.DidResume)
+						}
+						if ss.ECHAccepted != ech || cs.ECHAccepted != ech {
+							t.Fatalf("ECH acceptance server=%v client=%v", ss.ECHAccepted, cs.ECHAccepted)
+						}
+					}
