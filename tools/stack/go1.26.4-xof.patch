+++ b/src/crypto/tls/internal/tls13dec/turboshake_test.go
@@ -0,0 +1,156 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls13dec
+
+import (
+	"bytes"
+	"encoding/hex"
+	"strings"
+	"testing"
+)
+
+func decodeHex(t *testing.T, s string) []byte {
+	t.Helper()
+	s = strings.Map(func(r rune) rune {
+		if r == ' ' || r == '\n' || r == '\t' {
+			return -1
+		}
+		return r
+	}, s)
+	b, err := hex.DecodeString(s)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
+
+func pow17(i int) int {
+	n := 1
+	for ; i > 0; i-- {
+		n *= 17
+	}
+	return n
+}
+
+type turboSHAKEVector struct {
+	m    []byte
+	n    int
+	last int // if nonzero, compare only the trailing last bytes
+	out  string
+}
+
+// RFC 9861, Appendix A.3.
+var turboSHAKE256Vectors = []turboSHAKEVector{
+	{[]byte{}, 64, 0,
+		`36 7A 32 9D AF EA 87 1C 78 02 EC 67 F9 05 AE 13
+		 C5 76 95 DC 2C 66 63 C6 10 35 F5 9A 18 F8 E7 DB
+		 11 ED C0 E1 2E 91 EA 60 EB 6B 32 DF 06 DD 7F 00
+		 2F BA FA BB 6E 13 EC 1C C2 0D 99 55 47 60 0D B0`},
+	{[]byte{}, 10032, 32,
+		`AB EF A1 16 30 C6 61 26 92 49 74 26 85 EC 08 2F
+		 20 72 65 DC CF 2F 43 53 4E 9C 61 BA 0C 9D 1D 75`},
+	{ptn(pow17(0)), 64, 0,
+		`3E 17 12 F9 28 F8 EA F1 05 46 32 B2 AA 0A 24 6E
+		 D8 B0 C3 78 72 8F 60 BC 97 04 10 15 5C 28 82 0E
+		 90 CC 90 D8 A3 00 6A A2 37 2C 5C 5E A1 76 B0 68
+		 2B F2 2B AE 74 67 AC 94 F7 4D 43 D3 9B 04 82 E2`},
+	{ptn(pow17(1)), 64, 0,
+		`B3 BA B0 30 0E 6A 19 1F BE 61 37 93 98 35 92 35
+		 78 79 4E A5 48 43 F5 01 10 90 FA 2F 37 80 A9 E5
+		 CB 22 C5 9D 78 B4 0A 0F BF F9 E6 72 C0 FB E0 97
+		 0B D2 C8 45 09 1C 60 44 D6 87 05 4D A5 D8 E9 C7`},
+	{ptn(pow17(2)), 64, 0,
+		`66 B8 10 DB 8E 90 78 04 24 C0 84 73 72 FD C9 57
+		 10 88 2F DE 31 C6 DF 75 BE B9 D4 CD 93 05 CF CA
+		 E3 5E 7B 83 E8 B7 E6 EB 4B 78 60 58 80 11 63 16
+		 FE 2C 07 8A 09 B9 4A D7 B8 21 3C 0A 73 8B 65 C0`},
+	{ptn(pow17(3)), 64, 0,
+		`C7 4E BC 91 9A 5B 3B 0D D1 22 81 85 BA 02 D2 9E
+		 F4 42 D6 9D 3D 42 76 A9 3E FE 0B F9 A1 6A 7D C0
+		 CD 4E AB AD AB 8C D7 A5 ED D9 66 95 F5 D3 60 AB
+		 E0 9E 2C 65 11 A3 EC 39 7D A3 B7 6B 9E 16 74 FB`},
+	{ptn(pow17(4)), 64, 0,
+		`02 CC 3A 88 97 E6 F4 F6 CC B6 FD 46 63 1B 1F 52
+		 07 B6 6C 6D E9 C7 B5 5B 2D 1A 23 13 4A 17 0A FD
+		 AC 23 4E AB A9 A7 7C FF 88 C1 F0 20 B7 37 24 61
+		 8C 56 87 B3 62 C4 30 B2 48 CD 38 64 7F 84 8A 1D`},
+	{ptn(pow17(5)), 64, 0,
+		`AD D5 3B 06 54 3E 58 4B 58 23 F6 26 99 6A EE 50
+		 FE 45 ED 15 F2 02 43 A7 16 54 85 AC B4 AA 76 B4
+		 FF DA 75 CE DF 6D 8C DC 95 C3 32 BD 56 F4 B9 86
+		 B5 8B B1 7D 17 78 BF C1 B1 A9 75 45 CD F4 EC 9F`},
+	{ptn(pow17(6)), 64, 0,
+		`9E 11 BC 59 C2 4E 73 99 3C 14 84 EC 66 35 8E F7
+		 1D B7 4A EF D8 4E 12 3F 78 00 BA 9C 48 53 E0 2C
+		 FE 70 1D 9E 6B B7 65 A3 04 F0 DC 34 A4 EE 3B A8
+		 2C 41 0F 0D A7 0E 86 BF BD 90 EA 87 7C 2D 61 04`},
+}
+
+// The schedule fixes the domain separation byte to 0x1F.
+func sumTurboSHAKE256(data []byte, n int) []byte {
+	x := new(turboSHAKE256)
+	x.Write(data)
+	out := make([]byte, n)
+	x.Read(out)
+	return out
+}
+
+func TestTurboSHAKE256Vectors(t *testing.T) {
+	for i, v := range turboSHAKE256Vectors {
+		want := decodeHex(t, v.out)
+		got := sumTurboSHAKE256(v.m, v.n)
+		if v.last > 0 {
+			got = got[len(got)-v.last:]
+		}
+		if !bytes.Equal(got, want) {
+			t.Errorf("vector %d: got %x, want %x", i, got, want)
+		}
+	}
+}
+
+// Exercise both state-copy implementations at absorb and squeeze boundaries.
+func TestXOFIncremental(t *testing.T) {
+	for _, p := range []*Profile{SHAKE256, TurboSHAKE256} {
+		t.Run(profileNames[p], func(t *testing.T) {
+			m := ptn(1000)
+			x := p.newXOF()
+			x.Write(m)
+			want := make([]byte, 400)
+			x.Read(want)
+			for _, split := range []int{0, 1, 135, 136, 137, 271, 272, 500, 1000} {
+				x := p.newXOF()
+				x.Write(m[:split])
+				c := x.clone()
+				x.Write(m[split:])
+				got := make([]byte, len(want))
+				x.Read(got)
+				if !bytes.Equal(got, want) {
+					t.Errorf("split %d: got %x, want %x", split, got, want)
+				}
+				c.Write(m[split:])
+				c.Read(got)
+				if !bytes.Equal(got, want) {
+					t.Errorf("clone at %d: got %x, want %x", split, got, want)
+				}
+				x.Reset()
+				x.Write(m)
+				x.Read(got)
+				if !bytes.Equal(got, want) {
+					t.Errorf("reset at %d: got %x, want %x", split, got, want)
+				}
+			}
+			x.Reset()
+			x.Write(m)
+			got := make([]byte, len(want))
+			x.Read(got[:1])
+			x.Read(got[1:136])
+			x.Read(got[136:137])
+			x.Read(got[137:])
+			if !bytes.Equal(got, want) {
+				t.Errorf("piecewise read: got %x, want %x", got, want)
+			}
+		})
+	}
+}
diff --git a/src/crypto/tls/internal/tls13dec/vectors_test.go b/src/crypto/tls/internal/tls13dec/vectors_test.go
new file mode 100644
index 0000000..6740dd6
--- /dev/null
+++ b/src/crypto/tls/internal/tls13dec/vectors_test.go
@@ -0,0 +1,85 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls13dec
+
+import (
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"maps"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+)
+
+// TestGenerateVectors exports this Go implementation's evaluation of
+// the appendix inputs from draft-current.md. TestAppendixCurrent checks
+// those independently computed values against the published appendix.
+// This output is not handshake or interoperability evidence.
+func TestGenerateVectors(t *testing.T) {
+	dir := os.Getenv("TLS13DEC_VECTOR_DIR")
+	if dir == "" {
+		t.Skip("TLS13DEC_VECTOR_DIR not set")
+	}
+	type vector struct {
+		Name   string `json:"name"`
+		Output string `json:"output"`
+	}
+	type profileSet struct {
+		Profile string   `json:"profile"`
+		Vectors []vector `json:"vectors"`
+	}
+	doc := struct {
+		Note     string       `json:"note"`
+		Profiles []profileSet `json:"profiles"`
+	}{Note: "Go fork evaluation of draft-sullivan-tls-xof-schedule appendix inputs from draft-current.md; all values, including input hashes and framing sequences. MAC is Derive(Init(key), mac, message, L). This is vector agreement, not a handshake or an interoperability test."}
+	var b strings.Builder
+	b.WriteString("# Go Fork Appendix Evaluation\n\nSource: draft-current.md. Values are hexadecimal.\n\n")
+	b.WriteString("These are independently evaluated appendix inputs and derived values.\nThis output is not handshake or interoperability evidence.\n\n")
+	total := 0
+	for _, p := range []*Profile{TurboSHAKE256, SHAKE256} {
+		values := appendixValues(p)
+		set := profileSet{Profile: profileNames[p]}
+		fmt.Fprintf(&b, "## %s\n\n", profileNames[p])
+		for _, name := range slices.Sorted(maps.Keys(values)) {
+			encoded := hex.EncodeToString(values[name])
+			set.Vectors = append(set.Vectors, vector{Name: name, Output: encoded})
+			fmt.Fprintf(&b, "%s:\n\n~~~~\n%s\n~~~~\n\n", name, encoded)
+			total++
+		}
+		doc.Profiles = append(doc.Profiles, set)
+	}
+	j, err := json.MarshalIndent(doc, "", "  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "vectors.json"), append(j, '\n'), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "appendix-test-vectors.md"), []byte(b.String()), 0644); err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("wrote %d appendix values (both profiles) to %s", total, dir)
+}
+
+func TestImportPSKFrameLimit(t *testing.T) {
+	for _, tc := range profiles() {
+		t.Run(tc.name, func(t *testing.T) {
+			// The external PSK is framed directly. ImportedIdentity is
+			// hashed and may exceed the frame limit.
+			if got := tc.profile.ImportPSK(ptn(maxFrame), ptn(maxFrame+1)); len(got) != SecretSize {
+				t.Errorf("import at frame limit produced %d octets", len(got))
+			}
+			defer func() {
+				if recover() == nil {
+					t.Error("oversized external PSK was accepted")
+				}
+			}()
+			tc.profile.ImportPSK(ptn(maxFrame+1), nil)
+		})
+	}
+}
