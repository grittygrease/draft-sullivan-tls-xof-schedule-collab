+
+func TestRequireScheduleProfile(t *testing.T) {
+	for _, required := range []bool{false, true} {
+		for _, selected := range []uint16{0, scheduleTLS13TurboSHAKE256, scheduleTLS13SHAKE256} {
+			t.Run(fmt.Sprintf("required=%v/selected=%04x", required, selected), func(t *testing.T) {
+				config := &Config{requireScheduleProfile: required}
+				c := Client(&discardConn{}, config)
+				hs := &clientHandshakeStateTLS13{
+					c: c,
+					serverHello: &serverHelloMsg{
+						scheduleProfile: selected, scheduleProfileSelected: selected != 0,
+					},
+				}
+				err := hs.checkScheduleOffer(&clientHelloMsg{
+					scheduleProfiles: []uint16{scheduleTLS13TurboSHAKE256, scheduleTLS13SHAKE256},
+				})
+				if required && selected == 0 {
+					if err == nil || !errors.Is(c.out.err, alertHandshakeFailure) {
+						t.Fatalf("required XOF: error=%v, alert=%v; want handshake_failure", err, c.out.err)
+					}
+				} else if err != nil {
+					t.Fatal(err)
+				}
+				if config.Clone().requireScheduleProfile != required {
+					t.Fatal("Clone lost requireScheduleProfile")
+				}
+			})
+		}
+	}
+}
+
+// TestSelectScheduleProfile checks the server's KDF selection over the
+// client's offered schedule_profile list.
+func TestSelectScheduleProfile(t *testing.T) {
+	// A XOF KDF is selected in the client's preference order.
+	if p, id := selectScheduleProfile([]uint16{0x0101, 0x0100}); p != tls13dec.SHAKE256 || id != 0x0101 {
+		t.Errorf("offer [0101 0100]: got id=%#x, want 0101 SHAKE256", id)
+	}
+	if p, id := selectScheduleProfile([]uint16{0x0100}); p != tls13dec.TurboSHAKE256 || id != 0x0100 {
+		t.Errorf("offer [0100]: got id=%#x, want 0100 TurboSHAKE256", id)
+	}
+	// Unknown KDFs (e.g. HKDF_SHA256) select nothing: run RFC 8446 HKDF.
+	if p, id := selectScheduleProfile([]uint16{0x0001, 0x0002}); p != nil || id != 0 {
+		t.Errorf("offer of non-XOF KDFs: got id=%#x, want (nil,0)", id)
+	}
+	// An absent extension (nil offer) runs RFC 8446 HKDF.
+	if p, _ := selectScheduleProfile(nil); p != nil {
+		t.Error("nil offer must select no XOF KDF")
+	}
+	// The echo code point round-trips the profile.
+	if kdfForProfile(tls13dec.TurboSHAKE256) != 0x0100 || kdfForProfile(tls13dec.SHAKE256) != 0x0101 {
+		t.Error("kdfForProfile disagrees with the code points")
+	}
+}
+
+// TestScheduleProfileExtensionRoundTrip checks that the schedule_profile
+// extension of draft-sullivan-tls-xof-schedule marshals into a ClientHello
+// with altkdf-rs's experimental code points, and round-trips through
+// unmarshal (extension_type 0xffa6, ScheduleProfileList offering 0x0100
+// TLS13_TURBOSHAKE256 and 0x0101 TLS13_SHAKE256).
+func TestScheduleProfileExtensionRoundTrip(t *testing.T) {
+	m := &clientHelloMsg{
+		vers:               VersionTLS12,
+		random:             make([]byte, 32),
+		cipherSuites:       []uint16{TLS_AES_128_GCM_SHA256},
+		compressionMethods: []uint8{0},
+		scheduleProfiles:   []uint16{0x0100, 0x0101},
+	}
+	marshaled := mustMarshal(t, m)
+
+	// extension_type(0xffa6) || extension_data_len(0x0006) ||
+	// ScheduleProfileList{ profiles_len(0x0004) || 0x0100 || 0x0101 }.
+	want := []byte{0xff, 0xa6, 0x00, 0x06, 0x00, 0x04, 0x01, 0x00, 0x01, 0x01}
+	if !bytes.Contains(marshaled, want) {
+		t.Fatalf("schedule_profile extension %x not found in ClientHello %x", want, marshaled)
+	}
+
+	var got clientHelloMsg
+	if !got.unmarshal(marshaled) {
+		t.Fatal("ClientHello with schedule_profile did not unmarshal")
+	}
+	if !slices.Equal(got.scheduleProfiles, []uint16{0x0100, 0x0101}) {
+		t.Errorf("scheduleProfiles = %#x, want [0100 0101]", got.scheduleProfiles)
+	}
+}
+
+// TestScheduleProfileHRRCarrier checks the KDF pinned by a
+// HelloRetryRequest (a serverHelloMsg extension, single uint16).
+func TestScheduleProfileHRRCarrier(t *testing.T) {
+	sh := &serverHelloMsg{
+		vers:            VersionTLS12,
+		random:          make([]byte, 32),
+		cipherSuite:     TLS_AES_128_GCM_SHA256,
+		scheduleProfile: 0x0101, scheduleProfileSelected: true,
+	}
+	marshaled := mustMarshal(t, sh)
+	want := []byte{0xff, 0xa6, 0x00, 0x02, 0x01, 0x01}
+	if !bytes.Contains(marshaled, want) {
+		t.Fatalf("HRR schedule_profile %x not found in ServerHello %x", want, marshaled)
+	}
+	var got serverHelloMsg
+	if !got.unmarshal(marshaled) {
+		t.Fatal("ServerHello with schedule_profile did not unmarshal")
+	}
+	if !got.scheduleProfileSelected || got.scheduleProfile != 0x0101 {
+		t.Errorf("scheduleProfile = %#x selected=%v, want 0x0101 true", got.scheduleProfile, got.scheduleProfileSelected)
+	}
+}
