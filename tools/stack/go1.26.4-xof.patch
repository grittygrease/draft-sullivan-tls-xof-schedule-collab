index 0000000..81d7bc1
--- /dev/null
+++ b/src/crypto/tls/key_schedule_kdf_test.go
@@ -0,0 +1,310 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls
+
+import (
+	"bytes"
+	"crypto/rand"
+	"crypto/tls/internal/tls13dec"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"testing"
+
+	"crypto/internal/fips140/tls13"
+)
+
+// Check the handshake-facing API against the literal appendix, so the
+// adapter cannot silently select a different tuple or transcript checkpoint.
+func TestScheduleAppendix(t *testing.T) {
+	b, err := os.ReadFile("internal/tls13dec/testdata/appendix-current.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fixture map[string]map[string]string
+	if err := json.Unmarshal(b, &fixture); err != nil {
+		t.Fatal(err)
+	}
+	for name, p := range map[string]*tls13dec.Profile{
+		"TLS13_SHAKE256": tls13dec.SHAKE256, "TLS13_TURBOSHAKE256": tls13dec.TurboSHAKE256,
+	} {
+		t.Run(name, func(t *testing.T) {
+			values := fixture[name]
+			value := func(name string) []byte {
+				b, err := hex.DecodeString(values[name])
+				if err != nil || len(b) == 0 {
+					t.Fatalf("invalid fixture %q: %v", name, err)
+				}
+				return b
+			}
+			check := func(name string, got []byte) { checkEqual(t, name, got, value(name)) }
+			s := newTLS13Schedule(cipherSuiteTLS13ByID(TLS_AES_128_GCM_SHA256), p)
+			th := s.newTranscript()
+			th.Write([]byte("truncated ClientHello"))
+			s.setPSK(value(`TranscriptHash("psk")`))
+			check("binder verify_data", s.resumptionBinder(th))
+			th.Reset()
+			th.Write([]byte("ClientHello"))
+			check("c_e_traffic", s.clientEarlyTrafficSecret(th))
+			th.Reset()
+			th.Write([]byte("ClientHello..ServerHello"))
+			s.deriveHandshake([][]byte{value(`TranscriptHash("asymmetric ...")`)}, th)
+			check("c_hs_traffic", s.clientHandshakeTrafficSecret(th))
+			check("s_hs_traffic", s.serverHandshakeTrafficSecret(th))
+			th.Reset()
+			th.Write([]byte("ClientHello..before server Finished"))
+			check("server verify_data", s.finished(value("s_hs_traffic"), th))
+			th.Reset()
+			th.Write([]byte("ClientHello..server Finished"))
+			check("client verify_data", s.finished(value("c_hs_traffic"), th))
+			check("c_ap_traffic", s.clientApplicationTrafficSecret(th))
+			check("s_ap_traffic", s.serverApplicationTrafficSecret(th))
+			export := s.exporter(th)
+			got, err := export("test label", []byte("test context"), 32)
+			if err != nil {
+				t.Fatal(err)
+			}
+			check("TLS-Exporter (32 octets)", got)
+			next, key, iv := s.trafficKey(value("c_ap_traffic"), QUICEncryptionLevelApplication)
+			check("app_traffic_secret_1", next)
+			check("key_block", append(key, iv...))
+			th.Reset()
+			th.Write([]byte("ClientHello..client Finished"))
+			check("resumption_secret", s.resumptionMasterSecret(th))
+			check("resumption_psk (nonce)", s.resumptionPSK(value("resumption_secret"), []byte("nonce")))
+			random := make([]byte, 32)
+			for i := range random {
+				random[i] = byte(i)
+			}
+			for _, hrr := range []bool{false, true} {
+				input, name := "ech_conf_messages", "accept_confirmation"
+				if hrr {
+					input, name = "hrr_ech_conf_messages", "hrr_accept_confirmation"
+				}
+				th.Reset()
+				th.Write([]byte(input))
+				check(name, s.echConfirmation(random, th, hrr))
+			}
+		})
+	}
+}
+
+// TestKeyScheduleWrappers checks that each tls13Schedule wrapper reproduces
+// its reference schedule byte for byte over a full 1-RTT (no-PSK) chain:
+// the HKDF wrapper against direct crypto/internal/fips140/tls13 calls, and
+// the XOF wrapper against direct crypto/tls/internal/tls13dec calls. This
+// is what lets the handshake drive one tls13Schedule and get RFC 8446 or
+// the XOF key schedule depending only on the KDF handle.
+func TestKeyScheduleWrappers(t *testing.T) {
+	suite := cipherSuiteTLS13ByID(TLS_AES_128_GCM_SHA256)
+	sharedKey := bytes.Repeat([]byte{0x2a}, 32)
+
+	t.Run("hkdf", func(t *testing.T) {
+		sched := newTLS13Schedule(suite, nil)
+		thSH := suite.hash.New()
+		thSH.Write([]byte("vector transcript: TH_SH"))
+		thSF := suite.hash.New()
+		thSF.Write([]byte("vector transcript: TH_SF"))
+
+		sched.deriveHandshake([][]byte{sharedKey}, thSH)
+		gotCHS := sched.clientHandshakeTrafficSecret(thSH)
+		gotSHS := sched.serverHandshakeTrafficSecret(thSH)
+		gotCAP := sched.clientApplicationTrafficSecret(thSF)
+		gotFin := sched.finished(gotCHS, thSF)
+		_, gk, gv := sched.trafficKey(gotCHS, QUICEncryptionLevelHandshake)
+
+		// reference: direct RFC 8446 HKDF chain.
+		early := tls13.NewEarlySecret(suite.hash.New, nil)
+		hsSec := early.HandshakeSecret(sharedKey)
+		wantCHS := hsSec.ClientHandshakeTrafficSecret(thSH)
+		wantSHS := hsSec.ServerHandshakeTrafficSecret(thSH)
+		master := hsSec.MasterSecret()
+		wantCAP := master.ClientApplicationTrafficSecret(thSF)
+		wantFin := suite.finishedHash(gotCHS, thSF)
+		wk, wv := suite.trafficKey(gotCHS)
+
+		checkEqual(t, "c_hs_traffic", gotCHS, wantCHS)
+		checkEqual(t, "s_hs_traffic", gotSHS, wantSHS)
+		checkEqual(t, "c_ap_traffic", gotCAP, wantCAP)
+		checkEqual(t, "finished", gotFin, wantFin)
+		checkEqual(t, "key", gk, wk)
+		checkEqual(t, "iv", gv, wv)
+	})
+
+	for _, prof := range []*tls13dec.Profile{tls13dec.TurboSHAKE256, tls13dec.SHAKE256} {
+		t.Run("XOF", func(t *testing.T) {
+			sched := newTLS13Schedule(suite, prof)
+			thSH := prof.NewTranscriptHash()
+			thSH.Write([]byte("vector transcript: TH_SH"))
+			thSF := prof.NewTranscriptHash()
+			thSF.Write([]byte("vector transcript: TH_SF"))
+
+			sched.deriveHandshake([][]byte{sharedKey}, thSH)
+			gotCHS := sched.clientHandshakeTrafficSecret(thSH)
+			gotSHS := sched.serverHandshakeTrafficSecret(thSH)
+			gotCAP := sched.clientApplicationTrafficSecret(thSF)
+			gotFin := sched.finished(gotCHS, thSF)
+			_, gk, gv := sched.trafficKey(gotCHS, QUICEncryptionLevelHandshake)
+
+			// reference: direct tls13dec calls.
+			e := tls13dec.NewEarlyStage(prof, nil)
+			h := e.Handshake(sharedKey, thSH.Sum(nil))
+			wantCHS := h.ClientHandshakeTrafficSecret()
+			wantSHS := h.ServerHandshakeTrafficSecret()
+			a := h.Application(thSF.Sum(nil))
+			wantCAP := a.ClientApplicationTrafficSecret()
+			wantFin := prof.HandshakeFinished(gotCHS, thSF.Sum(nil), suite.keyLen, aeadNonceLength)
+			_, wk, wv := prof.HandshakeKeys(gotCHS, suite.keyLen, aeadNonceLength)
+
+			checkEqual(t, "c_hs_traffic", gotCHS, wantCHS)
+			checkEqual(t, "s_hs_traffic", gotSHS, wantSHS)
+			checkEqual(t, "c_ap_traffic", gotCAP, wantCAP)
+			checkEqual(t, "finished", gotFin, wantFin)
+			checkEqual(t, "key", gk, wk)
+			checkEqual(t, "iv", gv, wv)
+			if len(gotCHS) != prof.NewTranscriptHash().Size() {
+				t.Errorf("XOF secret length = %d, want 64", len(gotCHS))
+			}
+		})
+	}
+}
+
+func TestDecKeyUpdate(t *testing.T) {
+	for _, p := range []*tls13dec.Profile{tls13dec.SHAKE256, tls13dec.TurboSHAKE256} {
+		for _, id := range []uint16{TLS_AES_128_GCM_SHA256, TLS_AES_256_GCM_SHA384, TLS_CHACHA20_POLY1305_SHA256} {
+			suite := cipherSuiteTLS13ByID(id)
+			c := &Conn{kdf: p, cipherSuite: id, vers: VersionTLS13}
+			secret := bytes.Repeat([]byte{42}, 64)
+			if err := c.setReadTrafficSecret(suite, QUICEncryptionLevelApplication, secret, false); err != nil {
+				t.Fatal(err)
+			}
+			for range 2 {
+				next, _, _ := p.ApplicationKeys(secret, suite.keyLen, aeadNonceLength)
+				if err := c.handleKeyUpdate(&keyUpdateMsg{}); err != nil {
+					t.Fatal(err)
+				}
+				checkEqual(t, "updated traffic secret", c.in.trafficSecret, next)
+				secret = next
+			}
+		}
+	}
+}
+
+func checkEqual(t *testing.T, name string, got, want []byte) {
+	t.Helper()
+	if !bytes.Equal(got, want) {
+		t.Errorf("%s: wrapper = %x, reference = %x", name, got, want)
+	}
+}
+
+// Each hybrid component must reach the schedule separately and in the
+// negotiated group's order, so the dec engine can frame each under shs_.
+func TestHybridSharedSecretComponents(t *testing.T) {
+	for _, group := range []CurveID{X25519MLKEM768, SecP256r1MLKEM768, SecP384r1MLKEM1024} {
+		t.Run(group.String(), func(t *testing.T) {
+			ke, err := keyExchangeForCurveID(group)
+			if err != nil {
+				t.Fatal(err)
+			}
+			priv, shares, err := ke.keyShares(rand.Reader)
+			if err != nil {
+				t.Fatal(err)
+			}
+			serverSecret, serverShare, err := ke.serverSharedSecret(rand.Reader, shares[0].data)
+			if err != nil {
+				t.Fatal(err)
+			}
+			clientSecret, err := ke.clientSharedSecret(priv, serverShare.data)
+			if err != nil {
+				t.Fatal(err)
+			}
+			server, ok := any(serverSecret).([][]byte)
+			if !ok {
+				t.Fatalf("server key exchange flattened component boundaries into %T", serverSecret)
+			}
+			client, ok := any(clientSecret).([][]byte)
+			if !ok {
+				t.Fatalf("client key exchange flattened component boundaries into %T", clientSecret)
+			}
+			hybrid := ke.(*hybridKeyExchange)
+			var ecShare, ciphertext []byte
+			if group == X25519MLKEM768 {
+				ciphertext, ecShare = serverShare.data[:hybrid.mlkemCiphertextSize], serverShare.data[hybrid.mlkemCiphertextSize:]
+			} else {
+				ecShare, ciphertext = serverShare.data[:hybrid.ecdhElementSize], serverShare.data[hybrid.ecdhElementSize:]
+			}
+			pub, err := priv.ecdhe.Curve().NewPublicKey(ecShare)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ecSecret, err := priv.ecdhe.ECDH(pub)
+			if err != nil {
+				t.Fatal(err)
+			}
+			kemSecret, err := priv.mlkem.Decapsulate(ciphertext)
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := [][]byte{ecSecret, kemSecret}
+			if group == X25519MLKEM768 {
+				want = [][]byte{kemSecret, ecSecret}
+			}
+			if len(server) != len(want) || len(client) != len(want) {
+				t.Fatalf("component counts: server=%d, client=%d, want=%d", len(server), len(client), len(want))
+			}
+			for i := range want {
+				if !bytes.Equal(server[i], want[i]) || !bytes.Equal(client[i], want[i]) {
+					t.Errorf("component %d differs: server=%x client=%x want=%x", i, server[i], client[i], want[i])
+				}
+			}
+			t.Logf("matched %d components in group order, lengths %d and %d", len(want), len(want[0]), len(want[1]))
+			checkHybridSchedules(t, server, client)
+			for i := range want {
+				if !bytes.Equal(server[i], want[i]) || !bytes.Equal(client[i], want[i]) {
+					t.Errorf("schedule modified shared-secret component %d", i)
+				}
+			}
+		})
+	}
+}
+
+func checkHybridSchedules(t *testing.T, server, client [][]byte) {
+	t.Helper()
+	suite := cipherSuiteTLS13ByID(TLS_AES_128_GCM_SHA256)
+	t.Run("HKDF concatenates", func(t *testing.T) {
+		th := suite.hash.New()
+		th.Write([]byte("hybrid transcript"))
+		sched := newTLS13Schedule(suite, nil)
+		sched.deriveHandshake(server, th)
+		joined := bytes.Join(client, nil)
+		reference := tls13.NewEarlySecret(suite.hash.New, nil).HandshakeSecret(joined)
+		checkEqual(t, "hybrid HKDF c_hs_traffic", sched.clientHandshakeTrafficSecret(th), reference.ClientHandshakeTrafficSecret(th))
+		checkEqual(t, "hybrid HKDF s_hs_traffic", sched.serverHandshakeTrafficSecret(th), reference.ServerHandshakeTrafficSecret(th))
+	})
+	for _, tc := range []struct {
+		name string
+		p    *tls13dec.Profile
+	}{
+		{"TurboSHAKE256", tls13dec.TurboSHAKE256},
+		{"SHAKE256", tls13dec.SHAKE256},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			th := tc.p.NewTranscriptHash()
+			th.Write([]byte("hybrid transcript"))
+			serverSchedule, clientSchedule := newTLS13Schedule(suite, tc.p), newTLS13Schedule(suite, tc.p)
+			serverSchedule.deriveHandshake(server, th)
+			clientSchedule.deriveHandshake(client, th)
+			direct := tls13dec.NewEarlyStage(tc.p, nil).HandshakeComponents(server, th.Sum(nil))
+			got := serverSchedule.clientHandshakeTrafficSecret(th)
+			checkEqual(t, "hybrid client/server c_hs_traffic", got, clientSchedule.clientHandshakeTrafficSecret(th))
+			checkEqual(t, "hybrid separately tagged c_hs_traffic", got, direct.ClientHandshakeTrafficSecret())
+			checkEqual(t, "hybrid separately tagged s_hs_traffic", serverSchedule.serverHandshakeTrafficSecret(th), direct.ServerHandshakeTrafficSecret())
+			concatenated := tls13dec.NewEarlyStage(tc.p, nil).Handshake(bytes.Join(server, nil), th.Sum(nil))
+			if bytes.Equal(got, concatenated.ClientHandshakeTrafficSecret()) {
+				t.Error("XOF wrapper concatenated hybrid components before framing")
+			}
+		})
+	}
+}
diff --git a/src/crypto/tls/schedule_profile.go b/src/crypto/tls/schedule_profile.go
new file mode 100644
index 0000000..1ad5788
--- /dev/null
+++ b/src/crypto/tls/schedule_profile.go
@@ -0,0 +1,68 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls
+
+import "crypto/tls/internal/tls13dec"
+
+// This file maps the schedule_profile TLS KDF Identifiers of
+// draft-sullivan-tls-xof-schedule to the XOF profiles of
+// crypto/tls/internal/tls13dec, and selects the negotiated KDF. It is
+// the KDF-negotiation counterpart to the cipher-suite (AEAD) selection:
+// the AEAD comes from the RFC 8446 cipher suite, the KDF from the
+// schedule_profile extension. A nil *tls13dec.Profile means RFC 8446
+// HKDF over the cipher suite's hash (the extension was absent or offered
+// no supported KDF).
+//
+// The code points are experimental TLS KDF Identifiers shared with altkdf-rs;
+// IANA assignment is TBD (draft "IANA Considerations").
+
+const (
+	scheduleTLS13TurboSHAKE256 uint16 = 0x0100
+	scheduleTLS13SHAKE256      uint16 = 0x0101
+)
+
+// decProfileForKDF returns the XOF profile for a TLS KDF
+// Identifier, or nil if the identifier is not an XOF KDF this
+// implementation supports (including HKDF_SHA256/384, which have no XOF
+// profile and run the RFC 8446 schedule).
+func decProfileForKDF(id uint16) *tls13dec.Profile {
+	switch id {
+	case scheduleTLS13TurboSHAKE256:
+		return tls13dec.TurboSHAKE256
+	case scheduleTLS13SHAKE256:
+		return tls13dec.SHAKE256
+	}
+	return nil
+}
+
+// kdfForProfile returns the TLS KDF Identifier code point of an XOF
+// profile, for the ServerHello/HelloRetryRequest selection and ticket binding.
+func kdfForProfile(p *tls13dec.Profile) uint16 {
+	switch p {
+	case nil:
+		return 0
+	case tls13dec.SHAKE256:
+		return scheduleTLS13SHAKE256
+	default:
+		return scheduleTLS13TurboSHAKE256
+	}
+}
+
+// selectScheduleProfile chooses the KDF the server negotiates from the
+// client's offered schedule_profile list, in the client's preference
+// order, restricted to the XOF KDFs this implementation supports. It
+// returns the selected profile and its code point, or (nil, 0) to run
+// the RFC 8446 HKDF schedule.
+//
+// Selection follows the offered preference order. A ticket bound to another
+// KDF is declined by the handshake; it cannot change this selection.
+func selectScheduleProfile(offered []uint16) (*tls13dec.Profile, uint16) {
+	for _, id := range offered {
+		if p := decProfileForKDF(id); p != nil {
+			return p, id
+		}
+	}
+	return nil, 0
+}
