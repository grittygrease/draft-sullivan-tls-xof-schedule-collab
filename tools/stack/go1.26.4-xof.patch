diff --git a/src/crypto/tls/key_schedule_kdf.go b/src/crypto/tls/key_schedule_kdf.go
new file mode 100644
index 0000000..8326f30
--- /dev/null
+++ b/src/crypto/tls/key_schedule_kdf.go
@@ -0,0 +1,281 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls
+
+import (
+	"bytes"
+	"crypto/tls/internal/tls13dec"
+	"errors"
+	"hash"
+
+	"crypto/internal/fips140/hkdf"
+	"crypto/internal/fips140/tls13"
+)
+
+// An XOF exporter frames its raw label and binds its uint16 output length.
+var errExporterLength = errors.New("tls: exporter output length must be between 1 and 65535 bytes with this schedule profile")
+var errExporterLabel = errors.New("tls: exporter label is limited to 65535 bytes with this schedule profile")
+
+// A tls13Schedule is the TLS 1.3 key schedule of a connection: either RFC
+// 8446's HKDF schedule over the cipher suite's hash (hkdfSchedule) or the
+// XOF key schedule of draft-sullivan-tls-xof-schedule negotiated in the
+// schedule_profile extension (decSchedule). The branch between the two
+// lives entirely in these two implementations; the handshake drives one
+// tls13Schedule and never sees which it is.
+//
+// The AEAD is always the RFC 8446 cipher suite's (decoupled from the KDF);
+// record derivation therefore uses the suite's key length.
+//
+// Both schedules bind transcript checkpoints at leaves. The XOF wrapper
+// saves TH_SH when entering the handshake stage and TH_SF on the first
+// application-secret request; neither checkpoint enters a trunk or ratchet.
+// The HKDF wrapper uses the transcript supplied to each leaf method.
+type tls13Schedule interface {
+	// newTranscript returns a fresh transcript hash for this schedule
+	// (the suite's hash for HKDF, the 64-octet TranscriptHash for an XOF).
+	newTranscript() hash.Hash
+	// echConfirmation derives the ServerHello or HRR acceptance signal.
+	echConfirmation(random []byte, transcript hash.Hash, hrr bool) []byte
+	// secretLen is the length of stage, traffic, and binder secrets.
+	secretLen() int
+
+	// setPSK starts the early stage keyed by psk. Not called for a
+	// handshake without a PSK; deriveHandshake then starts it with nil.
+	setPSK(psk []byte)
+	// resumptionBinder computes a resumption PSK binder over the current
+	// (partial-ClientHello) transcript.
+	resumptionBinder(transcript hash.Hash) []byte
+	// clientEarlyTrafficSecret derives c_e_traffic over TH_CH.
+	clientEarlyTrafficSecret(transcript hash.Hash) []byte
+
+	// deriveHandshake crosses into the handshake stage with the ordered
+	// shared-secret components. transcript is TH_SH for handshake leaves.
+	deriveHandshake(sharedKey [][]byte, transcript hash.Hash)
+	clientHandshakeTrafficSecret(transcript hash.Hash) []byte
+	serverHandshakeTrafficSecret(transcript hash.Hash) []byte
+
+	// The application-secret methods lazily cross into the application
+	// stage on first use (transcript is TH_SF there).
+	clientApplicationTrafficSecret(transcript hash.Hash) []byte
+	serverApplicationTrafficSecret(transcript hash.Hash) []byte
+	// resumptionMasterSecret derives the resumption secret over TH_CF.
+	resumptionMasterSecret(transcript hash.Hash) []byte
+	// exporter returns an exporter keyed by the exporter secret (TH_SF).
+	exporter(transcript hash.Hash) func(label string, context []byte, length int) ([]byte, error)
+
+	// finished computes a Finished verify_data over the transcript.
+	finished(baseKey []byte, transcript hash.Hash) []byte
+	// trafficKey derives record material and retains the application successor.
+	trafficKey(secret []byte, level QUICEncryptionLevel) (next, key, iv []byte)
+	// resumptionPSK derives a NewSessionTicket PSK.
+	resumptionPSK(resumptionSecret, nonce []byte) []byte
+}
+
+// newTLS13Schedule returns the schedule for a connection: RFC 8446 HKDF
+// over suite.hash when kdf is nil, otherwise the XOF key schedule of kdf.
+func newTLS13Schedule(suite *cipherSuiteTLS13, kdf *tls13dec.Profile) tls13Schedule {
+	if kdf == nil {
+		return &hkdfSchedule{suite: suite}
+	}
+	return &decSchedule{p: kdf, keyLen: suite.keyLen}
+}
+
+type hkdfSchedule struct {
+	suite  *cipherSuiteTLS13
+	early  *tls13.EarlySecret
+	hsSec  *tls13.HandshakeSecret
+	master *tls13.MasterSecret
+}
+
+func (h *hkdfSchedule) newTranscript() hash.Hash { return h.suite.hash.New() }
+func (h *hkdfSchedule) secretLen() int           { return h.suite.hash.Size() }
+
+func (h *hkdfSchedule) setPSK(psk []byte) {
+	h.early = tls13.NewEarlySecret(h.suite.hash.New, psk)
+}
+
+func (h *hkdfSchedule) ensureEarly() {
+	if h.early == nil {
+		h.early = tls13.NewEarlySecret(h.suite.hash.New, nil)
+	}
+}
+
+func (h *hkdfSchedule) resumptionBinder(transcript hash.Hash) []byte {
+	h.ensureEarly()
+	return h.suite.finishedHash(h.early.ResumptionBinderKey(), transcript)
+}
+
+func (h *hkdfSchedule) clientEarlyTrafficSecret(transcript hash.Hash) []byte {
+	h.ensureEarly()
+	return h.early.ClientEarlyTrafficSecret(transcript)
+}
+
+func (h *hkdfSchedule) deriveHandshake(sharedKey [][]byte, _ hash.Hash) {
+	h.ensureEarly()
+	// RFC 8446 and the hybrid groups use concatenated input key material.
+	joined := bytes.Join(sharedKey, nil)
+	h.hsSec = h.early.HandshakeSecret(joined)
+	clear(joined)
+}
+
+func (h *hkdfSchedule) clientHandshakeTrafficSecret(transcript hash.Hash) []byte {
+	return h.hsSec.ClientHandshakeTrafficSecret(transcript)
+}
+func (h *hkdfSchedule) serverHandshakeTrafficSecret(transcript hash.Hash) []byte {
+	return h.hsSec.ServerHandshakeTrafficSecret(transcript)
+}
+
+func (h *hkdfSchedule) ensureMaster() {
+	if h.master == nil {
+		h.master = h.hsSec.MasterSecret()
+	}
+}
+
+func (h *hkdfSchedule) clientApplicationTrafficSecret(transcript hash.Hash) []byte {
+	h.ensureMaster()
+	return h.master.ClientApplicationTrafficSecret(transcript)
+}
+func (h *hkdfSchedule) serverApplicationTrafficSecret(transcript hash.Hash) []byte {
+	h.ensureMaster()
+	return h.master.ServerApplicationTrafficSecret(transcript)
+}
+func (h *hkdfSchedule) resumptionMasterSecret(transcript hash.Hash) []byte {
+	h.ensureMaster()
+	return h.master.ResumptionMasterSecret(transcript)
+}
+func (h *hkdfSchedule) exporter(transcript hash.Hash) func(string, []byte, int) ([]byte, error) {
+	h.ensureMaster()
+	return h.suite.exportKeyingMaterial(h.master, transcript)
+}
+
+func (h *hkdfSchedule) finished(baseKey []byte, transcript hash.Hash) []byte {
+	return h.suite.finishedHash(baseKey, transcript)
+}
+func (h *hkdfSchedule) trafficKey(secret []byte, level QUICEncryptionLevel) (next, key, iv []byte) {
+	if level == QUICEncryptionLevelApplication {
+		next = h.suite.nextTrafficSecret(secret)
+	}
+	key, iv = h.suite.trafficKey(secret)
+	return
+}
+func (h *hkdfSchedule) resumptionPSK(resumptionSecret, nonce []byte) []byte {
+	return tls13.ExpandLabel(h.suite.hash.New, resumptionSecret, "resumption", nonce, h.suite.hash.Size())
+}
+
+type decSchedule struct {
+	keyLen int
+	p      *tls13dec.Profile
+	early  *tls13dec.EarlyStage
+	hs     *tls13dec.HandshakeStage
+	app    *tls13dec.AppStage
+}
+
+func (d *decSchedule) newTranscript() hash.Hash { return d.p.NewTranscriptHash() }
+func (d *decSchedule) secretLen() int           { return tls13dec.SecretSize }
+
+func (d *decSchedule) setPSK(psk []byte) {
+	d.early = tls13dec.NewEarlyStage(d.p, psk)
+}
+
+func (d *decSchedule) ensureEarly() {
+	if d.early == nil {
+		d.early = tls13dec.NewEarlyStage(d.p, nil)
+	}
+}
+
+func (d *decSchedule) resumptionBinder(transcript hash.Hash) []byte {
+	d.ensureEarly()
+	key := d.early.BinderKey(false)
+	defer clear(key)
+	return d.p.Finished(key, transcript.Sum(nil))
+}
+
+func (d *decSchedule) clientEarlyTrafficSecret(transcript hash.Hash) []byte {
+	d.ensureEarly()
+	return d.early.ClientEarlyTrafficSecret(transcript.Sum(nil))
+}
+
+func (d *decSchedule) deriveHandshake(sharedKey [][]byte, transcript hash.Hash) {
+	d.ensureEarly()
+	d.hs = d.early.HandshakeComponents(sharedKey, transcript.Sum(nil))
+}
+
+func (d *decSchedule) clientHandshakeTrafficSecret(hash.Hash) []byte {
+	return d.hs.ClientHandshakeTrafficSecret()
+}
+func (d *decSchedule) serverHandshakeTrafficSecret(hash.Hash) []byte {
+	return d.hs.ServerHandshakeTrafficSecret()
+}
+
+func (d *decSchedule) ensureApp(transcript hash.Hash) {
+	if d.app == nil {
+		d.app = d.hs.Application(transcript.Sum(nil))
+	}
+}
+
+func (d *decSchedule) clientApplicationTrafficSecret(transcript hash.Hash) []byte {
+	d.ensureApp(transcript)
+	return d.app.ClientApplicationTrafficSecret()
+}
+func (d *decSchedule) serverApplicationTrafficSecret(transcript hash.Hash) []byte {
+	d.ensureApp(transcript)
+	return d.app.ServerApplicationTrafficSecret()
+}
+func (d *decSchedule) resumptionMasterSecret(transcript hash.Hash) []byte {
+	// TH_CF is this leaf's context; TH_SF is not part of its path.
+	return d.app.ResumptionMasterSecret(transcript.Sum(nil))
+}
+func (d *decSchedule) exporter(transcript hash.Hash) func(string, []byte, int) ([]byte, error) {
+	d.ensureApp(transcript)
+	expMaster := d.app.ExporterMasterSecret()
+	return func(label string, context []byte, length int) ([]byte, error) {
+		if length < 1 || length > 0xFFFF {
+			return nil, errExporterLength
+		}
+		if len(label) > 65535 {
+			return nil, errExporterLabel
+		}
+		return d.p.Exporter(expMaster, label, context, length), nil
+	}
+}
+
+func (d *decSchedule) finished(baseKey []byte, transcript hash.Hash) []byte {
+	return d.p.HandshakeFinished(baseKey, transcript.Sum(nil), d.keyLen, aeadNonceLength)
+}
+func (d *decSchedule) trafficKey(secret []byte, level QUICEncryptionLevel) (next, key, iv []byte) {
+	switch level {
+	case QUICEncryptionLevelEarly:
+		key, iv = d.p.TrafficKeys(secret, d.keyLen, aeadNonceLength)
+	case QUICEncryptionLevelHandshake:
+		var finished []byte
+		finished, key, iv = d.p.HandshakeKeys(secret, d.keyLen, aeadNonceLength)
+		clear(finished)
+	case QUICEncryptionLevelApplication:
+		next, key, iv = d.p.ApplicationKeys(secret, d.keyLen, aeadNonceLength)
+	default:
+		panic("tls: invalid record key level")
+	}
+	return
+}
+func (d *decSchedule) resumptionPSK(resumptionSecret, nonce []byte) []byte {
+	return d.p.ResumptionPSK(resumptionSecret, nonce)
+}
+
+func (h *hkdfSchedule) echConfirmation(random []byte, transcript hash.Hash, hrr bool) []byte {
+	label := "ech accept confirmation"
+	if hrr {
+		label = "hrr ech accept confirmation"
+	}
+	key := hkdf.Extract(h.suite.hash.New, random, nil)
+	defer clear(key)
+	return tls13.ExpandLabel(h.suite.hash.New, key, label, transcript.Sum(nil), 8)
+}
+
+func (d *decSchedule) echConfirmation(random []byte, transcript hash.Hash, hrr bool) []byte {
+	if hrr {
+		return d.p.ECHHRRAcceptConfirmation(random, transcript.Sum(nil))
+	}
+	return d.p.ECHAcceptConfirmation(random, transcript.Sum(nil))
+}
