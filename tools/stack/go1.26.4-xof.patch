+++ b/src/crypto/tls/xof_interop_test.go
@@ -0,0 +1,346 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls
+
+import (
+	"bufio"
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"math/big"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+const xofInteropTimeout = 15 * time.Second
+
+// These tests use real loopback TCP and opt-in, independently built peers.
+// The Rust binaries come from altkdf-rs/tls-demo; the stock Go server comes
+// from a separate HKDF-only program built with a stock toolchain.
+func TestXOFInteropRustServer(t *testing.T) {
+	binary := xofInteropExecutable(t, "XOF_INTEROP_RUST_SERVER")
+	for _, id := range []uint16{scheduleTLS13TurboSHAKE256, scheduleTLS13SHAKE256} {
+		t.Run(fmt.Sprintf("%04x", id), func(t *testing.T) {
+			port := xofInteropFreePort(t)
+			peer := xofInteropStart(t, binary, port)
+			peer.line(t, "deck-server: listening ")
+			c := xofInteropClient(t, port, id, true)
+			if err := c.Handshake(); err != nil {
+				t.Fatal(err)
+			}
+			xofInteropCheckState(t, c, id)
+			xofInteropEcho(t, c)
+			xofInteropCheckKDF(t, peer, id)
+		})
+	}
+}
+
+func TestXOFInteropRustClient(t *testing.T) {
+	binary := xofInteropExecutable(t, "XOF_INTEROP_RUST_CLIENT")
+	config := &Config{
+		Certificates:           []Certificate{xofInteropCertificate(t)},
+		MinVersion:             VersionTLS13,
+		MaxVersion:             VersionTLS13,
+		NextProtos:             []string{"deck-demo"},
+		SessionTicketsDisabled: true,
+	}
+	// This fork's server accepts both supported XOF profiles automatically.
+	l := xofInteropListen(t)
+	peer := xofInteropStart(t, binary, strconv.Itoa(l.Addr().(*net.TCPAddr).Port))
+	if err := l.SetDeadline(time.Now().Add(xofInteropTimeout)); err != nil {
+		t.Fatal(err)
+	}
+	raw, err := l.Accept()
+	if err != nil {
+		t.Fatalf("accept Rust client: %v\n%s", err, peer.output())
+	}
+	c := Server(raw, config)
+	t.Cleanup(func() { c.Close() })
+	if err := c.SetDeadline(time.Now().Add(xofInteropTimeout)); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.Handshake(); err != nil {
+		t.Fatal(err)
+	}
+	id := kdfForProfile(c.kdf)
+	if id != scheduleTLS13TurboSHAKE256 && id != scheduleTLS13SHAKE256 {
+		t.Fatalf("Rust client negotiated KDF %#04x, want an XOF profile", id)
+	}
+	xofInteropCheckState(t, c, id)
+	line, err := bufio.NewReader(c).ReadString('\n')
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := io.WriteString(c, line); err != nil {
+		t.Fatal(err)
+	}
+	exporter := xofInteropExporter(t, c)
+	peer.wait(t)
+	if got := peer.line(t, "server echoed: "); got != strings.TrimSuffix(line, "\n") {
+		t.Fatalf("Rust client received %q, want %q", got, line)
+	}
+	xofInteropCheckKDF(t, peer, id)
+	xofInteropCheckExporter(t, peer.line(t, "exporter: "), exporter)
+}
+
+func TestXOFInteropStockServer(t *testing.T) {
+	binary := xofInteropExecutable(t, "XOF_INTEROP_STOCK_SERVER")
+	for _, id := range []uint16{scheduleTLS13TurboSHAKE256, scheduleTLS13SHAKE256} {
+		t.Run(fmt.Sprintf("%04x", id), func(t *testing.T) {
+			port := xofInteropFreePort(t)
+			peer := xofInteropStart(t, binary, port)
+			peer.line(t, "listening")
+			t.Run("fallback", func(t *testing.T) {
+				c := xofInteropClient(t, port, id, false)
+				if err := c.Handshake(); err != nil {
+					t.Fatal(err)
+				}
+				xofInteropCheckState(t, c, 0)
+				xofInteropEcho(t, c)
+				xofInteropCheckExporter(t, peer.line(t, "exporter: "), xofInteropExporter(t, c))
+			})
+			t.Run("required", func(t *testing.T) {
+				c := xofInteropClient(t, port, id, true)
+				if err := c.Handshake(); !errors.Is(err, alertHandshakeFailure) {
+					t.Fatalf("required XOF handshake = %v, want handshake_failure", err)
+				}
+				if c.ConnectionState().HandshakeComplete {
+					t.Fatal("required XOF handshake completed on stock server")
+				}
+			})
+		})
+	}
+}
+
+func xofInteropExecutable(t *testing.T, variable string) string {
+	t.Helper()
+	name := os.Getenv(variable)
+	if name == "" {
+		t.Skipf("set %s to an interop executable", variable)
+	}
+	path, err := exec.LookPath(name)
+	if err != nil {
+		t.Skipf("%s does not name an executable: %v", variable, err)
+	}
+	path, err = filepath.Abs(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+// A single reader drains both output streams. Waiting for the scanner before
+// Cmd.Wait preserves final output from short-lived clients. Cleanup kills and
+// reaps servers even when a handshake or an output assertion fails.
+type xofInteropProcess struct {
+	lines chan string
+	done  chan struct{}
+	err   error // read after done is closed
+	mu    sync.Mutex
+	log   strings.Builder
+}
+
+func xofInteropStart(t *testing.T, binary, port string) *xofInteropProcess {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 2*xofInteropTimeout)
+	cmd := exec.CommandContext(ctx, binary, port)
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		cancel()
+		t.Fatal(err)
+	}
+	cmd.Stderr = cmd.Stdout
+	if err := cmd.Start(); err != nil {
+		cancel()
+		stdout.Close()
+		t.Fatal(err)
+	}
+	p := &xofInteropProcess{lines: make(chan string, 64), done: make(chan struct{})}
+	go func() {
+		scanner := bufio.NewScanner(stdout)
+		for scanner.Scan() {
+			line := scanner.Text()
+			p.mu.Lock()
+			p.log.WriteString(line + "\n")
+			p.mu.Unlock()
+			select {
+			case p.lines <- strings.TrimSpace(line):
+			case <-ctx.Done():
+			}
+		}
+		p.err = errors.Join(scanner.Err(), cmd.Wait())
+		close(p.lines)
+		close(p.done)
+	}()
+	t.Cleanup(func() {
+		cancel()
+		stdout.Close()
+		<-p.done
+		if t.Failed() {
+			t.Logf("%s output:\n%s", binary, p.output())
+		}
+	})
+	return p
+}
+
+func (p *xofInteropProcess) output() string {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.log.String()
+}
+
+func (p *xofInteropProcess) line(t *testing.T, prefix string) string {
+	t.Helper()
+	timer := time.NewTimer(xofInteropTimeout)
+	defer timer.Stop()
+	for {
+		select {
+		case line, ok := <-p.lines:
+			if !ok {
+				t.Fatalf("peer exited without %q:\n%s", prefix, p.output())
+			}
+			if value, ok := strings.CutPrefix(line, prefix); ok {
+				return value
+			}
+		case <-timer.C:
+			t.Fatalf("timed out waiting for %q:\n%s", prefix, p.output())
+		}
+	}
+}
+
+func (p *xofInteropProcess) wait(t *testing.T) {
+	t.Helper()
+	select {
+	case <-p.done:
+		if p.err != nil {
+			t.Fatalf("peer failed: %v\n%s", p.err, p.output())
+		}
+	case <-time.After(xofInteropTimeout):
+		t.Fatalf("peer did not exit:\n%s", p.output())
+	}
+}
+
+func xofInteropListen(t *testing.T) *net.TCPListener {
+	t.Helper()
+	l, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { l.Close() })
+	return l
+}
+
+func xofInteropFreePort(t *testing.T) string {
+	t.Helper()
+	l := xofInteropListen(t)
+	port := strconv.Itoa(l.Addr().(*net.TCPAddr).Port)
+	if err := l.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return port
+}
+
+func xofInteropClient(t *testing.T, port string, profile uint16, required bool) *Conn {
+	t.Helper()
+	raw, err := net.DialTimeout("tcp4", net.JoinHostPort("127.0.0.1", port), xofInteropTimeout)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := Client(raw, &Config{
+		ServerName:             "localhost",
+		InsecureSkipVerify:     true,
+		NextProtos:             []string{"deck-demo"},
+		MinVersion:             VersionTLS13,
+		MaxVersion:             VersionTLS13,
+		scheduleProfiles:       []uint16{profile},
+		requireScheduleProfile: required,
+	})
+	t.Cleanup(func() { c.Close() })
+	if err := c.SetDeadline(time.Now().Add(xofInteropTimeout)); err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
+
+func xofInteropCheckState(t *testing.T, c *Conn, profile uint16) {
+	t.Helper()
+	s := c.ConnectionState()
+	if !s.HandshakeComplete || s.Version != VersionTLS13 || s.NegotiatedProtocol != "deck-demo" || kdfForProfile(c.kdf) != profile {
+		t.Fatalf("handshake complete=%v, version=%#04x, ALPN=%q, KDF=%#04x; want TLS 1.3, deck-demo, KDF=%#04x",
+			s.HandshakeComplete, s.Version, s.NegotiatedProtocol, kdfForProfile(c.kdf), profile)
+	}
+}
+
+func xofInteropEcho(t *testing.T, c *Conn) {
+	t.Helper()
+	const line = "hello from Go XOF interop\n"
+	if _, err := io.WriteString(c, line); err != nil {
+		t.Fatal(err)
+	}
+	if got, err := bufio.NewReader(c).ReadString('\n'); err != nil || got != line {
+		t.Fatalf("echo = %q, %v; want %q", got, err, line)
+	}
+}
+
+func xofInteropCheckKDF(t *testing.T, peer *xofInteropProcess, id uint16) {
+	t.Helper()
+	want := fmt.Sprintf("Some(\"0x%04x\")", id)
+	if got := peer.line(t, "kdf: "); got != want {
+		t.Fatalf("Rust KDF = %q, want %q", got, want)
+	}
+}
+
+func xofInteropExporter(t *testing.T, c *Conn) string {
+	t.Helper()
+	s := c.ConnectionState()
+	b, err := s.ExportKeyingMaterial("deck-demo exporter", []byte("context"), 32)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return hex.EncodeToString(b)
+}
+
+func xofInteropCheckExporter(t *testing.T, got, want string) {
+	t.Helper()
+	if got != want {
+		t.Fatalf("peer exporter = %q, want %q", got, want)
+	}
+}
+
+func xofInteropCertificate(t *testing.T) Certificate {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject:      pkix.Name{CommonName: "localhost"},
+		DNSNames:     []string{"localhost"},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+		KeyUsage:     x509.KeyUsageDigitalSignature,
+		ExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return Certificate{Certificate: [][]byte{der}, PrivateKey: key}
+}
