+	"maps"
+	"os"
+	"slices"
+	"testing"
+)
+
+// appendixValues drives the fork's production schedule with the appendix's
+// stated inputs. The recording XOF observes Init/Absorb bytes and the
+// actual ratchet outputs without changing the production code.
+func appendixValues(profile *Profile) map[string][]byte {
+	rec := &recorder{}
+	p := shadowProfile(profile, rec)
+	out := make(map[string][]byte)
+	hash := func(s string) []byte { return p.TranscriptHash([]byte(s)) }
+	for name, input := range map[string]string{
+		`TranscriptHash("psk")`: "psk", `TranscriptHash("asymmetric ...")`: "asymmetric shared secret",
+		`TranscriptHash("epsk")`: "epsk", "TH_CH0": "truncated ClientHello", "TH_CH": "ClientHello",
+		"TH_SH": "ClientHello..ServerHello", "TH_PRE_SF": "ClientHello..before server Finished",
+		"TH_SF": "ClientHello..server Finished", "TH_CF": "ClientHello..client Finished",
+	} {
+		out[name] = hash(input)
+	}
+	psk, shared := out[`TranscriptHash("psk")`], out[`TranscriptHash("asymmetric ...")`]
+	e := NewEarlyStage(p, psk)
+	seq := e.e.x.(*recordingXOF).buf
+	out["Init() sequence"] = bytes.Clone(seq[:8])
+	out[`Absorb(E,"psk_",PSK) contributed`] = bytes.Clone(seq[8:])
+	empty := NewEarlyStage(p, nil)
+	out[`Absorb(E,"psk_","") contributed`] = bytes.Clone(empty.e.x.(*recordingXOF).buf[8:])
+	empty.e.destroy()
+	out["c_e_traffic"] = e.ClientEarlyTrafficSecret(out["TH_CH"])
+	out["early_exporter_secret"] = e.EarlyExporterMasterSecret(out["TH_CH"])
+	binder := func(e *EarlyStage, label, suffix, verify string) {
+		key := e.binderKey(label)
+		out["binder_key ("+label+")"] = key
+		fk := p.expand(key, "fin", nil, SecretSize)
+		out["finished_key ("+suffix+")"] = fk
+		out[verify] = p.mac(fk, out["TH_CH0"], MACSize)
+	}
+	binder(e, "rbk", "binder", "binder verify_data")
+	out["residue E->H"] = bytes.Clone(e.residue)
+	external := NewEarlyStage(p, psk)
+	binder(external, "ebk", "external binder", "external binder verify_data")
+	external.destroy()
+	h := e.Handshake(shared, out["TH_SH"])
+	out["c_hs_traffic"], out["s_hs_traffic"] = h.ClientHandshakeTrafficSecret(), h.ServerHandshakeTrafficSecret()
+	for _, side := range []string{"client", "server"} {
+		secret, th := out["c_hs_traffic"], out["TH_SF"]
+		if side == "server" {
+			secret, th = out["s_hs_traffic"], out["TH_PRE_SF"]
+		}
+		fk, key, iv := p.HandshakeKeys(secret, 16, 12)
+		out["finished_key ("+side+")"] = fk
+		out[side+" verify_data"] = p.mac(fk, th, MACSize)
+		out["key_block ("+side+" handshake)"] = append(bytes.Clone(key), iv...)
+	}
+	a := h.Application(out["TH_SF"])
+	// Application computes its tuple after the ratchet; observe the seeded trunk.
+	out["residue H->T"] = bytes.Clone(a.t.x.(*recordingXOF).buf[16:80])
+	out["c_ap_traffic"], out["s_ap_traffic"] = a.ClientApplicationTrafficSecret(), a.ServerApplicationTrafficSecret()
+	out["exporter_secret"] = a.ExporterMasterSecret()
+	out["resumption_secret"] = a.ResumptionMasterSecret(out["TH_CF"])
+	record := func(secret []byte, blockName, nextName string) []byte {
+		next, key, iv := p.ApplicationKeys(secret, 16, 12)
+		out[blockName], out[nextName] = append(bytes.Clone(key), iv...), next
+		return next
+	}
+	next := record(out["c_ap_traffic"], "key_block", "app_traffic_secret_1")
+	out["write_key = key_block[0..16]"] = out["key_block"][:16]
+	out["write_iv  = key_block[16..28]"] = out["key_block"][16:]
+	record(next, "key_block (client generation 1)", "app_traffic_secret_2 (lookahead)")
+	next = record(out["s_ap_traffic"], "key_block (server application)", "server_app_traffic_secret_1")
+	record(next, "key_block (server generation 1)", "server_app_traffic_secret_2 (lookahead)")
+	key, iv := p.TrafficKeys(out["c_e_traffic"], 16, 12)
+	out["key_block (early)"] = append(bytes.Clone(key), iv...)
+	out["resumption_psk (nonce)"] = p.ResumptionPSK(out["resumption_secret"], []byte("nonce"))
+	out["resumption_psk (empty nonce)"] = p.ResumptionPSK(out["resumption_secret"], nil)
+	out["exporter_label_secret"] = p.expand(out["exporter_secret"], "exl", []byte("test label"), SecretSize)
+	out["early_exporter_label_secret"] = p.expand(out["early_exporter_secret"], "exl", []byte("test label"), SecretSize)
+	out["TLS-Exporter (32 octets)"] = p.Exporter(out["exporter_secret"], "test label", []byte("test context"), 32)
+	out["early exporter (32 octets)"] = p.Exporter(out["early_exporter_secret"], "test label", []byte("test context"), 32)
+	targetKDF := uint16(0x0100)
+	if profile == SHAKE256 {
+		targetKDF = 0x0101
+	}
+	id := append(framedSequence([]byte("external psk identity")), 0, 0, 3, 4)
+	id = append(id, u16(targetKDF)...)
+	out["ImportedIdentity"] = id
+	out["ipsk (ipk)"] = p.ImportPSK(out[`TranscriptHash("epsk")`], id)
+	ie := NewEarlyStage(p, out["ipsk (ipk)"])
+	binder(ie, "ibk", "imported binder", "imported binder verify_data")
+	out["residue E->H (imported)"] = bytes.Clone(ie.residue)
+	ih := ie.Handshake(shared, out["TH_SH"])
+	out["c_hs_traffic (imported)"], out["s_hs_traffic (imported)"] = ih.ClientHandshakeTrafficSecret(), ih.ServerHandshakeTrafficSecret()
+	ne := NewEarlyStage(p, nil)
+	nh := ne.Handshake(shared, out["TH_SH"])
+	out["residue E->H (no PSK)"] = bytes.Clone(nh.h.x.(*recordingXOF).buf[16:80])
+	out["c_hs_traffic (no PSK)"], out["s_hs_traffic (no PSK)"] = nh.ClientHandshakeTrafficSecret(), nh.ServerHandshakeTrafficSecret()
+	random := make([]byte, 32)
+	for i := range random {
+		random[i] = byte(i)
+	}
+	out["accept_confirmation"] = p.ECHAcceptConfirmation(random, hash("ech_conf_messages"))
+	out["hrr_accept_confirmation"] = p.ECHHRRAcceptConfirmation(random, hash("hrr_ech_conf_messages"))
+	// The same engine supports the appendix's DTLS schedule label.
+	dtls := *p
+	dtls.scheduleLabel = "dtls13"
+	de := NewEarlyStage(&dtls, psk)
+	out["Init() sequence (DTLS)"] = bytes.Clone(de.e.x.(*recordingXOF).buf[:8])
+	dh := de.Handshake(shared, out["TH_SH"])
+	out["c_hs_traffic (DTLS)"] = dh.ClientHandshakeTrafficSecret()
+	da := dh.Application(out["TH_SF"])
+	out["c_ap_traffic (DTLS)"] = da.ClientApplicationTrafficSecret()
+	_, key, iv = dtls.ApplicationKeys(out["c_ap_traffic (DTLS)"], 16, 12)
+	out["key_block (DTLS)"] = append(bytes.Clone(key), iv...)
+	out["sn_key (DTLS, Nk=16)"] = dtls.expand(out["c_ap_traffic (DTLS)"], "snk", nil, 16)
+	out["sn_key (DTLS handshake, Nk=16)"] = dtls.expand(out["c_hs_traffic (DTLS)"], "snk", nil, 16)
+	// Serialized messages are the literal appendix fixtures, including headers.
+	cert, _ := hex.DecodeString("0b0000d601a50000d10000cc" +
+		"3081c9307da003020102020101300506032b6570300f310d300b06035504030c" +
+		"0474657374301e170d3236303130313030303030305a170d3336303130313030" +
+		"303030305a300f310d300b06035504030c0474657374302a300506032b657003" +
+		"210003a107bff3ce10be1d70dd18e74bc09967e4d6309ba50d5f1ddc86641255" +
+		"31b8300506032b657003410023c815b130eac1285714a01f2b99ffb720c5b234" +
+		"06ff492bbf9a4852f6e6c99f000959f0a2886763e10679390eee02d4e48d6f38" +
+		"2729357fc52bde69e6430f07" + "0000")
+	cv := append([]byte{15, 0, 0, 68, 8, 7, 0, 64}, make([]byte, 64)...)
+	hc := p.Exporter(out["exporter_secret"], "EXPORTER-server authenticator handshake context", nil, 64)
+	fk := p.Exporter(out["exporter_secret"], "EXPORTER-server authenticator finished key", nil, 64)
+	out["Handshake Context"], out["Finished MAC Key"] = hc, fk
+	hcCert := append(bytes.Clone(hc), cert...)
+	out["TranscriptHash(HC || Certificate)"] = p.TranscriptHash(hcCert)
+	out["Finished"] = p.mac(fk, p.TranscriptHash(append(hcCert, cv...)), MACSize)
+	emptyCert := append(append(bytes.Clone(hc), []byte("CertificateRequest")...), 11, 0, 0, 4, 0, 0, 0, 0)
+	out["Finished (empty authenticator)"] = p.mac(fk, p.TranscriptHash(emptyCert), MACSize)
+	for _, mode := range []string{"PSK-only", "hybrid"} {
+		var components [][]byte
+		if mode == "hybrid" {
+			components = [][]byte{hash("hybrid component 1"), hash("hybrid component 2")}
+		}
+		h := NewEarlyStage(p, psk).HandshakeComponents(components, out["TH_SH"])
+		out["c_hs_traffic ("+mode+")"], out["s_hs_traffic ("+mode+")"] = h.ClientHandshakeTrafficSecret(), h.ServerHandshakeTrafficSecret()
+		out["c_ap_traffic ("+mode+")"] = h.Application(out["TH_SF"]).ClientApplicationTrafficSecret()
+	}
+	return out
+}
+
+// The fixture is extracted verbatim from draft-current.md, all 81 values
+// per profile. No generator implementation computes the expected values.
+func TestAppendixCurrent(t *testing.T) {
+	b, err := os.ReadFile("testdata/appendix-current.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var want map[string]map[string]string
+	if err := json.Unmarshal(b, &want); err != nil {
+		t.Fatal(err)
+	}
+	if len(want) != 2 {
+		t.Fatal("expected both profiles")
+	}
+	for _, p := range []*Profile{SHAKE256, TurboSHAKE256} {
+		t.Run(profileNames[p], func(t *testing.T) {
+			got := appendixValues(p)
+			if len(got) != 81 || len(want[profileNames[p]]) != 81 {
+				t.Fatalf("value counts: got %d, fixture %d; want 81", len(got), len(want[profileNames[p]]))
+			}
+			for _, name := range slices.Sorted(maps.Keys(want[profileNames[p]])) {
+				expected, err := hex.DecodeString(want[profileNames[p]][name])
+				if err != nil {
+					t.Fatal(err)
+				}
+				value, ok := got[name]
+				if !ok {
+					t.Errorf("missing %q", name)
+					continue
+				}
+				if !bytes.Equal(value, expected) {
+					i := 0
+					for i < len(value) && i < len(expected) && value[i] == expected[i] {
+						i++
+					}
+					t.Errorf("%s: first differing byte %d (zero-based); got %x; want %x", name, i, value, expected)
+				} else {
+					t.Logf("APPENDIX_MATCH %s: %x", name, value)
+				}
+			}
+		})
+	}
+}
diff --git a/src/crypto/tls/internal/tls13dec/dec.go b/src/crypto/tls/internal/tls13dec/dec.go
new file mode 100644
index 0000000..730cbb1
--- /dev/null
+++ b/src/crypto/tls/internal/tls13dec/dec.go
@@ -0,0 +1,292 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Package tls13dec implements the dec engine-based key schedule shared by
+// both schedule profiles of draft-sullivan-tls-xof-schedule. Both
+// profiles express the key schedule as a dec engine and differ only
+// in the underlying permutation: TLS13_TURBOSHAKE256 uses TurboSHAKE256
+// (12-round Keccak-p[1600,12]) and TLS13_SHAKE256 uses SHAKE256
+// (24-round Keccak-f[1600]). The dec engine operations (Init/Absorb/Derive/
+// DeriveN/Ratchet), the stage schedule, the retained-secret expansion,
+// the 64-octet transcript hash, and the Derive-based Finished/binder
+// MAC are defined once here and parameterized by a Profile.
+package tls13dec
+
+import (
+	"crypto/sha3"
+	"hash"
+)
+
+// scheduleLabel is the fixed 6-octet schedule_label "tls13 " (with a
+// trailing space), framed at Init into every derivation of both
+// profiles. It marks the TLS 1.3 XOF key schedule and is identical for both
+// profiles: the two are separated by their XOF (12-round TurboSHAKE256
+// vs 24-round SHAKE256), not by this label.
+const scheduleLabel = "tls13 "
+
+// transcriptPrefix is the unkeyed domain-separation prefix of
+// TranscriptHash: TranscriptHash(x) = DF("tls13 hash" || x, 64), with
+// the prefix absorbed raw, not framed.
+const transcriptPrefix = "tls13 hash"
+
+const (
+	// TranscriptHashSize is the output length of TranscriptHash.
+	TranscriptHashSize = 64
+	// MACSize is FLen, the length of Finished and PSK binder
+	// verify_data.
+	MACSize = 64
+	// SecretSize is SecretLen, the length of every stage and traffic
+	// secret and of finished_key and binder_key.
+	SecretSize = 64
+)
+
+// maxFrame is the largest input or output length the framing accepts.
+const maxFrame = 0xFFFF
+
+// xof is the incremental extendable-output interface the dec engine needs
+// from a profile's permutation: absorb, squeeze, reset, and clone of an
+// unfinalized state.
+type xof interface {
+	Write(p []byte) (int, error)
+	Read(p []byte) (int, error)
+	Reset()
+	clone() xof
+}
+
+type shakeXOF struct{ *sha3.SHAKE }
+
+func (s shakeXOF) clone() xof {
+	state, err := s.MarshalBinary()
+	if err != nil {
+		panic("tls13dec: SHAKE clone failed: " + err.Error())
+	}
+	defer clear(state)
+	c := sha3.NewSHAKE256()
+	if err := c.UnmarshalBinary(state); err != nil {
+		panic("tls13dec: SHAKE clone failed: " + err.Error())
+	}
+	return shakeXOF{c}
+}
+
+// A Profile is a schedule profile of draft-sullivan-tls-xof-schedule:
+// the dec engine's permutation (via newXOF). Both profiles frame
+// the same fixed schedule_label at Init and differ only in the
+// permutation. The negotiated TLS KDF Identifier enters no derivation.
+type Profile struct {
+	newXOF        func() xof
+	scheduleLabel string // empty selects TLS; "dtls13" is used by the appendix
+}
+
+// TurboSHAKE256 is the TLS13_TURBOSHAKE256 profile: a TurboSHAKE256
+// dec engine, including its MAC.
+var TurboSHAKE256 = &Profile{
+	newXOF: func() xof { return new(turboSHAKE256) },
+}
+
+// SHAKE256 is the TLS13_SHAKE256 profile: a SHAKE256 dec engine, including its MAC.
+var SHAKE256 = &Profile{
+	newXOF: func() xof { return shakeXOF{sha3.NewSHAKE256()} },
+}
+
+// decEngine is a dec accumulator: the profile's XOF over the injectively
+// framed input sequence.
+type decEngine struct {
+	p *Profile
+	x xof
+}
+
+func (st *decEngine) absorbFrame(v []byte) {
+	if st.x == nil {
+		panic("tls13dec: retired dec engine")
+	}
+	if len(v) > maxFrame {
+		panic("tls13dec: input exceeds frame limit")
+	}
+	st.x.Write([]byte{byte(len(v) >> 8), byte(len(v))})
+	st.x.Write(v)
+}
+
+// initEngine implements Init([seed]). An explicitly supplied empty seed
+// is framed; omitting the argument omits the seed item entirely.
+func (p *Profile) initEngine(seed ...[]byte) *decEngine {
+	if len(seed) > 1 {
+		panic("tls13dec: multiple Init seeds")
+	}
+	st := &decEngine{p: p, x: p.newXOF()}
+	label := p.scheduleLabel
+	if label == "" {
+		label = scheduleLabel
+	}
+	st.absorbFrame([]byte(label))
+	if len(seed) == 1 {
+		st.absorb("seed", seed[0])
+	}
+	return st
+}
+
+// absorb adds one tagged input: seq || frame(tag) || frame(v).
+func (st *decEngine) absorb(tag string, v []byte) {
+	if len(tag) != 4 {
+		panic("tls13dec: tag must be four octets")
+	}
+	st.absorbFrame([]byte(tag))
+	st.absorbFrame(v)
+}
+
+// derive clones the dec engine and appends its optional context, label, and
+// output length, in that order. Stage leaves use th__; retained-secret
+// derivations use ctx_. Neither kind of context changes the trunk.
+func (st *decEngine) derive(label, ctag string, context []byte, n int) []byte {
+	if st.x == nil {
+		panic("tls13dec: retired dec engine")
+	}
+	if !registeredLabel(label) {
+		panic("tls13dec: unregistered derivation label")
+	}
+	if n < 1 || n > maxFrame {
+		panic("tls13dec: output length exceeds frame limit")
+	}
+	c := &decEngine{p: st.p, x: st.x.clone()}
+	defer c.destroy()
+	if len(context) != 0 {
+		c.absorb(ctag, context)
+	}
+	c.absorbFrame([]byte(label))
+	c.absorb("out_", u16(uint16(n)))
+	out := make([]byte, n)
+	c.x.Read(out)
+	return out
+}
+
+// output is one descriptor in a fixed DeriveN tuple.
+type output struct {
+	label  string
+	length int
+}
+
+func registeredLabel(label string) bool {
+	switch label {
+	case "cet", "ees", "ebk", "ibk", "rbk", "drv", "cht", "sht", "cat", "sat", "exs", "rss", "fin", "mac", "key", "upd", "rsp", "ipk", "exl", "exp", "eca", "hca", "snk":
+		return true
+	}
+	return false
+}
+
+// deriveN binds the entire ordered descriptor list before squeezing once.
+// It clones the accumulator, just like derive; the returned slices are disjoint.
+func (st *decEngine) deriveN(outputs []output, ctag string, context []byte) [][]byte {
+	if st.x == nil {
+		panic("tls13dec: retired dec engine")
+	}
+	if len(outputs) < 2 || len(outputs) > maxFrame {
+		panic("tls13dec: invalid output count")
+	}
+	total := 0
+	seen := make(map[string]bool, len(outputs))
+	for _, o := range outputs {
+		if !registeredLabel(o.label) || seen[o.label] || o.length < 1 || o.length > maxFrame-total {
+			panic("tls13dec: invalid output descriptor")
+		}
+		seen[o.label] = true
+		total += o.length
+	}
+	c := &decEngine{p: st.p, x: st.x.clone()}
+	defer c.destroy()
+	if len(context) != 0 {
+		c.absorb(ctag, context)
+	}
+	c.absorb("outs", u16(uint16(len(outputs))))
+	for _, o := range outputs {
+		c.absorbFrame([]byte(o.label))
+		c.absorb("out_", u16(uint16(o.length)))
+	}
+	buf := make([]byte, total)
+	c.x.Read(buf)
+	out := make([][]byte, len(outputs))
+	for i, o := range outputs {
+		out[i], buf = buf[:o.length:o.length], buf[o.length:]
+	}
+	return out
+}
+
+// ratchet retires the old dec engine and seeds its successor with the drv
+// residue. The temporary residue is erased after Init absorbs it.
+func (st *decEngine) ratchet() *decEngine {
+	residue := st.derive("drv", "", nil, SecretSize)
+	st.destroy()
+	next := st.p.initEngine(residue)
+	clear(residue)
+	return next
+}
+
+func (st *decEngine) destroy() {
+	if st.x != nil {
+		st.x.Reset()
+		st.x = nil
+	}
+}
+
+// u16 is the two-octet big-endian encoding of n.
+func u16(n uint16) []byte {
+	return []byte{byte(n >> 8), byte(n)}
+}
+
+// expand realizes a value keyed by a retained octet-string secret as a
+// dec engine session: Derive(Init(secret), label, context, n).
+func (p *Profile) expand(secret []byte, label string, context []byte, n int) []byte {
+	d := p.initEngine(secret)
+	defer d.destroy()
+	return d.derive(label, "ctx_", context, n)
+}
+
+// mac is MAC(key, message, L) = Derive(Init(key), "mac", message, L).
+func (p *Profile) mac(key, message []byte, n int) []byte {
+	return p.expand(key, "mac", message, n)
+}
+
+// TranscriptHash returns the 64-octet unkeyed transcript hash of x:
+// DF("tls13 hash" || x, 64), the prefix absorbed raw.
+func (p *Profile) TranscriptHash(x []byte) []byte {
+	h := p.newXOF()
+	h.Write([]byte(transcriptPrefix))
+	h.Write(x)
+	out := make([]byte, TranscriptHashSize)
+	h.Read(out)
+	return out
+}
+
+// transcriptHash is the incremental form of TranscriptHash, a
+// hash.Hash and hash.Cloner with Size() = 64.
+type transcriptHash struct {
+	x xof
+}
+
+// NewTranscriptHash returns an incremental TranscriptHash for the
+// profile.
+func (p *Profile) NewTranscriptHash() hash.Hash {
+	t := &transcriptHash{x: p.newXOF()}
+	t.x.Write([]byte(transcriptPrefix))
+	return t
+}
+
+func (t *transcriptHash) Write(p []byte) (int, error) { return t.x.Write(p) }
+
+func (t *transcriptHash) Sum(b []byte) []byte {
+	c := t.x.clone()
+	out := make([]byte, TranscriptHashSize)
+	c.Read(out)
+	return append(b, out...)
+}
+
+func (t *transcriptHash) Reset() {
+	t.x.Reset()
+	t.x.Write([]byte(transcriptPrefix))
+}
+
+func (t *transcriptHash) Size() int      { return TranscriptHashSize }
+func (t *transcriptHash) BlockSize() int { return 136 }
+
+func (t *transcriptHash) Clone() (hash.Cloner, error) {
+	return &transcriptHash{x: t.x.clone()}, nil
+}
diff --git a/src/crypto/tls/internal/tls13dec/derive_n_test.go b/src/crypto/tls/internal/tls13dec/derive_n_test.go
new file mode 100644
index 0000000..3a4a4a5
--- /dev/null
+++ b/src/crypto/tls/internal/tls13dec/derive_n_test.go
@@ -0,0 +1,56 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls13dec
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestDeriveNEncoding(t *testing.T) {
+	for _, tc := range profiles() {
+		d := tc.profile.initEngine([]byte("seed"))
+		seq := framedSequence([]byte("tls13 "), []byte("seed"), []byte("seed"),
+			[]byte("ctx_"), []byte("context"), []byte("outs"), []byte{0, 2},
+			[]byte("fin"), []byte("out_"), []byte{0, 64},
+			[]byte("key"), []byte("out_"), []byte{0, 28})
+		want := tc.oneShot(seq, 92)
+		before := d.derive("fin", "", nil, 64)
+		got := d.deriveN([]output{{"fin", 64}, {"key", 28}}, "ctx_", []byte("context"))
+		if !bytes.Equal(got[0], want[:64]) || !bytes.Equal(got[1], want[64:]) {
+			t.Fatalf("%s: DeriveN framing or partition differs", tc.name)
+		}
+		if !bytes.Equal(before, d.derive("fin", "", nil, 64)) {
+			t.Fatal("DeriveN consumed its parent")
+		}
+		changed := d.deriveN([]output{{"fin", 63}, {"key", 29}}, "ctx_", []byte("context"))
+		if bytes.Equal(got[0][:63], changed[0]) {
+			t.Fatal("partition lengths were not bound")
+		}
+	}
+}
+
+func TestDeriveNBounds(t *testing.T) {
+	mustPanic(t, func() { SHAKE256.initEngine().derive("bad", "", nil, 64) })
+	for _, outputs := range [][]output{
+		nil, {{"fin", 64}}, {{"fin", 0}, {"key", 1}},
+		{{"fin", -1}, {"key", 1}}, {{"fin", 65536}, {"key", 1}},
+		{{"fin", 65535}, {"key", 1}}, {{"fin", 1}, {"fin", 1}},
+		{{"bad", 1}, {"key", 1}}, {{"finished", 1}, {"key", 1}},
+		make([]output, 65536),
+	} {
+		mustPanic(t, func() { SHAKE256.initEngine().deriveN(outputs, "", nil) })
+	}
+	for _, n := range []int{-1, 0, 65536} {
+		mustPanic(t, func() { SHAKE256.initEngine().derive("key", "", nil, n) })
+	}
+	for _, n := range []int{0, 65536} {
+		mustPanic(t, func() { SHAKE256.Exporter(ptn(64), "label", nil, n) })
+	}
+	mustPanic(t, func() { SHAKE256.Exporter(ptn(64), string(ptn(65536)), nil, 1) })
+	if len(SHAKE256.Exporter(ptn(64), string(ptn(65535)), nil, 65535)) != 65535 {
+		t.Fatal("exporter rejected the frame limit")
+	}
+}
diff --git a/src/crypto/tls/internal/tls13dec/injectivity_test.go b/src/crypto/tls/internal/tls13dec/injectivity_test.go
