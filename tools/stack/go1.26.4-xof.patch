diff --git a/src/crypto/tls/dec_evidence_test.go b/src/crypto/tls/dec_evidence_test.go
new file mode 100644
index 0000000..fdcdf59
--- /dev/null
+++ b/src/crypto/tls/dec_evidence_test.go
@@ -0,0 +1,374 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/tls/internal/tls13dec"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"strings"
+	"testing"
+	"time"
+)
+
+// TestDecHandshakeEvidence records a real same-codebase TLS handshake. The
+// separate endpoint key logs and captured records demonstrate which schedule
+// ran, and permit verification of both Finished messages from the wire. This
+// test is implementation self-consistency evidence, not independent interop.
+func TestDecHandshakeEvidence(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		id   uint16
+		p    *tls13dec.Profile
+	}{
+		{"TurboSHAKE256", scheduleTLS13TurboSHAKE256, tls13dec.TurboSHAKE256},
+		{"SHAKE256", scheduleTLS13SHAKE256, tls13dec.SHAKE256},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var clientLog, serverLog bytes.Buffer
+			clientConfig := testConfig.Clone()
+			clientConfig.Rand = rand.Reader
+			clientConfig.MinVersion, clientConfig.MaxVersion = VersionTLS13, VersionTLS13
+			clientConfig.CurvePreferences = []CurveID{X25519}
+			clientConfig.scheduleProfiles = []uint16{tc.id}
+			clientConfig.ClientSessionCache = NewLRUClientSessionCache(1)
+			clientConfig.SessionTicketsDisabled = false
+			clientConfig.KeyLogWriter = &clientLog
+			serverConfig := testConfig.Clone()
+			serverConfig.Rand = rand.Reader
+			serverConfig.MinVersion, serverConfig.MaxVersion = VersionTLS13, VersionTLS13
+			serverConfig.CurvePreferences = []CurveID{X25519}
+			serverConfig.SessionTicketsDisabled = false
+			serverConfig.KeyLogWriter = &serverLog
+
+			c, s := localPipe(t)
+			t.Cleanup(func() { c.Close(); s.Close() })
+			deadline := time.Now().Add(10 * time.Second)
+			if err := c.SetDeadline(deadline); err != nil {
+				t.Fatal(err)
+			}
+			if err := s.SetDeadline(deadline); err != nil {
+				t.Fatal(err)
+			}
+			clientWire := &decEvidenceConn{Conn: c}
+			serverWire := &decEvidenceConn{Conn: s}
+			cli, srv := Client(clientWire, clientConfig), Server(serverWire, serverConfig)
+			ctx, cancel := context.WithDeadline(context.Background(), deadline)
+			defer cancel()
+			serverDone := make(chan error, 1)
+			const request, response = "client XOF application data", "server XOF application data"
+			go func() {
+				if err := srv.HandshakeContext(ctx); err != nil {
+					serverDone <- fmt.Errorf("server handshake: %w", err)
+					return
+				}
+				buf := make([]byte, len(request))
+				if _, err := io.ReadFull(srv, buf); err != nil {
+					serverDone <- fmt.Errorf("server application read: %w", err)
+					return
+				}
+				if string(buf) != request {
+					serverDone <- fmt.Errorf("server application data = %q", buf)
+					return
+				}
+				_, err := io.WriteString(srv, response)
+				serverDone <- err
+			}()
+			// Closing both transports and joining the worker on an early failure
+			// prevents a leaked goroutine or a test waiting for its full deadline.
+			joined := false
+			defer func() {
+				c.Close()
+				s.Close()
+				if !joined {
+					<-serverDone
+				}
+			}()
+			if err := cli.HandshakeContext(ctx); err != nil {
+				t.Fatalf("client handshake: %v", err)
+			}
+			if _, err := io.WriteString(cli, request); err != nil {
+				t.Fatal(err)
+			}
+			buf := make([]byte, len(response))
+			if _, err := io.ReadFull(cli, buf); err != nil {
+				t.Fatal(err)
+			}
+			if string(buf) != response {
+				t.Fatalf("client application data = %q", buf)
+			}
+			err := <-serverDone
+			joined = true
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			cs, ss := cli.ConnectionState(), srv.ConnectionState()
+			if cli.kdf != tc.p || srv.kdf != tc.p {
+				t.Fatal("client or server selected a different KDF (including HKDF fallback)")
+			}
+			if cs.Version != VersionTLS13 || ss.Version != VersionTLS13 ||
+				!cs.HandshakeComplete || !ss.HandshakeComplete || cs.DidResume || ss.DidResume ||
+				cs.CipherSuite != ss.CipherSuite || cs.CurveID != X25519 || ss.CurveID != X25519 {
+				t.Fatalf("unexpected states: client=%+v server=%+v", cs, ss)
+			}
+			suite := cipherSuiteTLS13ByID(cs.CipherSuite)
+			// The factory assertion checks the concrete implementation associated
+			// with the negotiated profile; the schedule itself is local to handshake().
+			if _, ok := newTLS13Schedule(suite, cli.kdf).(*decSchedule); !ok {
+				t.Fatal("negotiated profile does not select decSchedule")
+			}
+			clientSecrets := decEvidenceKeyLog(t, clientLog.String())
+			serverSecrets := decEvidenceKeyLog(t, serverLog.String())
+			for _, label := range []string{keyLogLabelClientHandshake, keyLogLabelServerHandshake,
+				keyLogLabelClientTraffic, keyLogLabelServerTraffic} {
+				if len(clientSecrets[label]) != tls13dec.SecretSize ||
+					!bytes.Equal(clientSecrets[label], serverSecrets[label]) {
+					t.Fatalf("endpoint key logs disagree for %s or do not contain a 64-byte secret", label)
+				}
+				decEvidenceLog(t, map[string]any{"event": "traffic_secret", "label": label,
+					"client": hex.EncodeToString(clientSecrets[label]), "server": hex.EncodeToString(serverSecrets[label])})
+			}
+			if len(cli.resumptionSecret) != tls13dec.SecretSize ||
+				!bytes.Equal(cli.resumptionSecret, srv.resumptionSecret) {
+				t.Fatal("endpoint resumption secrets disagree or are absent")
+			}
+			decEvidenceLog(t, map[string]any{"event": "resumption_secret",
+				"client": hex.EncodeToString(cli.resumptionSecret), "server": hex.EncodeToString(srv.resumptionSecret)})
+			clientExport, err := cs.ExportKeyingMaterial("fork handshake evidence", []byte("context"), 32)
+			if err != nil {
+				t.Fatal(err)
+			}
+			serverExport, err := ss.ExportKeyingMaterial("fork handshake evidence", []byte("context"), 32)
+			if err != nil || !bytes.Equal(clientExport, serverExport) {
+				t.Fatalf("endpoint exporters disagree: %v", err)
+			}
+			decEvidenceLog(t, map[string]any{"event": "exporter", "label": "fork handshake evidence",
+				"context": "context", "client": hex.EncodeToString(clientExport), "server": hex.EncodeToString(serverExport)})
+			decEvidenceLog(t, map[string]any{"event": "wire_capture", "transport": "local byte-stream sockets",
+				"client_records": hex.EncodeToString(clientWire.written.Bytes()),
+				"server_records": hex.EncodeToString(serverWire.written.Bytes())})
+
+			clientHello, clientFlight := decEvidenceFlight(t, clientWire.written.Bytes(), tc.p, suite, clientSecrets[keyLogLabelClientHandshake])
+			serverHello, serverFlight := decEvidenceFlight(t, serverWire.written.Bytes(), tc.p, suite, clientSecrets[keyLogLabelServerHandshake])
+			ch, sh := new(clientHelloMsg), new(serverHelloMsg)
+			if !ch.unmarshal(clientHello) || !sh.unmarshal(serverHello) ||
+				len(ch.scheduleProfiles) != 1 || ch.scheduleProfiles[0] != tc.id ||
+				!sh.scheduleProfileSelected || sh.scheduleProfile != tc.id {
+				t.Fatal("captured ClientHello/ServerHello do not carry the expected profile")
+			}
+			transcript := tc.p.NewTranscriptHash()
+			transcript.Write(clientHello)
+			transcript.Write(serverHello)
+			decEvidenceLog(t, map[string]any{"event": "negotiation", "profile": tc.name,
+				"kdf_id": fmt.Sprintf("0x%04x", tc.id), "tls_version": fmt.Sprintf("0x%04x", cs.Version),
+				"cipher_suite": CipherSuiteName(cs.CipherSuite), "group": "X25519", "factory_type": "*tls.decSchedule",
+				"client_hello": hex.EncodeToString(clientHello), "server_hello": hex.EncodeToString(serverHello),
+				"th_sh": hex.EncodeToString(transcript.Sum(nil)), "hkdf_fallback": false})
+			for _, flight := range []struct {
+				sender string
+				data   []byte
+				secret []byte
+			}{
+				{"server", serverFlight, clientSecrets[keyLogLabelServerHandshake]},
+				{"client", clientFlight, clientSecrets[keyLogLabelClientHandshake]},
+			} {
+				messages := decEvidenceMessages(t, flight.data)
+				for _, msg := range messages {
+					if msg[0] == typeFinished {
+						want := tc.p.HandshakeFinished(flight.secret, transcript.Sum(nil), suite.keyLen, aeadNonceLength)
+						if !bytes.Equal(want, msg[4:]) {
+							t.Fatalf("captured %s Finished does not verify", flight.sender)
+						}
+						decEvidenceLog(t, map[string]any{"event": "finished", "sender": flight.sender,
+							"transcript_hash_before": hex.EncodeToString(transcript.Sum(nil)),
+							"wire_verify_data":       hex.EncodeToString(msg[4:]), "recomputed": hex.EncodeToString(want),
+							"verified_by_peer": true, "wire_recheck": true})
+					}
+					transcript.Write(msg)
+				}
+				decEvidenceLog(t, map[string]any{"event": "transcript_checkpoint", "after": flight.sender + "_finished",
+					"hash": hex.EncodeToString(transcript.Sum(nil))})
+			}
+			decEvidenceLog(t, map[string]any{"event": "complete", "client_handshake_complete": true,
+				"server_handshake_complete": true, "application_data_both_directions": true,
+				"randomness":         "crypto/rand.Reader; fresh ephemeral X25519 keys",
+				"server_certificate": "Go TLS test fixture", "client_insecure_skip_verify": clientConfig.InsecureSkipVerify,
+				"certificate_verify_signature_checked": true,
+				"early_stage":                          "no PSK; no early traffic or early exporter leaves requested",
+				"scope":                                "same-codebase self-consistency; not independent interoperability"})
+		})
+	}
+}
+
+type decEvidenceConn struct {
+	net.Conn
+	written bytes.Buffer
+}
+
+func (c *decEvidenceConn) Write(p []byte) (int, error) {
+	n, err := c.Conn.Write(p)
+	c.written.Write(p[:n])
+	return n, err
+}
+
+func decEvidenceLog(t *testing.T, event map[string]any) {
+	t.Helper()
+	data, err := json.Marshal(event)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("DEC_EVIDENCE %s", data)
+}
+
+func decEvidenceKeyLog(t *testing.T, log string) map[string][]byte {
+	t.Helper()
+	secrets := make(map[string][]byte)
+	for _, line := range strings.Split(strings.TrimSpace(log), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) != 3 || len(fields[1]) != 64 {
+			t.Fatalf("malformed key log line %q", line)
+		}
+		if _, ok := secrets[fields[0]]; ok {
+			t.Fatalf("duplicate key log label %s", fields[0])
+		}
+		value, err := hex.DecodeString(fields[2])
+		if err != nil {
+			t.Fatal(err)
+		}
+		secrets[fields[0]] = value
+	}
+	if len(secrets) != 4 {
+		t.Fatalf("key log contains %d secrets, want 4", len(secrets))
+	}
+	return secrets
+}
+
+// decEvidenceFlight decrypts the initial encrypted handshake flight through
+// Finished, using the actual key log. Later application records (including
+// NewSessionTicket) use a different key and are deliberately excluded.
+func decEvidenceFlight(t *testing.T, wire []byte, p *tls13dec.Profile, suite *cipherSuiteTLS13, secret []byte) (hello, flight []byte) {
+	t.Helper()
+	_, key, iv := p.HandshakeKeys(secret, suite.keyLen, aeadNonceLength)
+	a := suite.aead(key, iv)
+	var seq uint64
+	for len(wire) > 0 {
+		if len(wire) < recordHeaderLen {
+			t.Fatal("truncated captured TLS record header")
+		}
+		n := recordHeaderLen + int(binary.BigEndian.Uint16(wire[3:5]))
+		if n > len(wire) {
+			t.Fatal("truncated captured TLS record")
+		}
+		record := wire[:n]
+		wire = wire[n:]
+		switch recordType(record[0]) {
+		case recordTypeHandshake:
+			hello = append(hello, record[recordHeaderLen:]...)
+		case recordTypeChangeCipherSpec:
+		case recordTypeApplicationData:
+			var nonce [8]byte
+			binary.BigEndian.PutUint64(nonce[:], seq)
+			plain, err := a.Open(nil, nonce[:], record[recordHeaderLen:], record[:recordHeaderLen])
+			if err != nil {
+				t.Fatalf("captured handshake record %d: %v", seq, err)
+			}
+			seq++
+			i := len(plain) - 1
+			for i >= 0 && plain[i] == 0 {
+				i--
+			}
+			if i < 0 || recordType(plain[i]) != recordTypeHandshake {
+				t.Fatal("captured initial flight contains a non-handshake record")
+			}
+			flight = append(flight, plain[:i]...)
+			for remaining := flight; len(remaining) >= 4; {
+				n := 4 + int(remaining[1])<<16 + int(remaining[2])<<8 + int(remaining[3])
+				if n > len(remaining) {
+					break
+				}
+				if remaining[0] == typeFinished {
+					if n != len(remaining) {
+						t.Fatal("unexpected handshake messages following Finished")
+					}
+					return hello, flight
+				}
+				remaining = remaining[n:]
+			}
+		default:
+			t.Fatalf("unexpected captured TLS record type %d", record[0])
+		}
+	}
+	t.Fatal("captured handshake flight lacks Finished")
+	return nil, nil
+}
+
+func decEvidenceMessages(t *testing.T, data []byte) [][]byte {
+	t.Helper()
+	var messages [][]byte
+	for len(data) > 0 {
+		if len(data) < 4 {
+			t.Fatal("truncated captured handshake header")
+		}
+		n := 4 + int(data[1])<<16 + int(data[2])<<8 + int(data[3])
+		if n > len(data) {
+			t.Fatal("truncated captured handshake message")
+		}
+		messages = append(messages, data[:n])
+		data = data[n:]
+	}
+	return messages
+}
+
+func TestDecExporterBounds(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		p    *tls13dec.Profile
+	}{
+		{"TurboSHAKE256", tls13dec.TurboSHAKE256},
+		{"SHAKE256", tls13dec.SHAKE256},
+	} {
+		p := tc.p
+		d := &decSchedule{p: p}
+		th := p.NewTranscriptHash()
+		d.deriveHandshake([][]byte{[]byte("shared secret")}, th)
+		export := d.exporter(th)
+		t.Run(tc.name+"/output65535", func(t *testing.T) {
+			got, err := export("label", nil, 65535)
+			if err != nil || len(got) != 65535 {
+				t.Fatalf("65535-byte exporter = (%d bytes, %v), want success", len(got), err)
+			}
+		})
+		t.Run(tc.name+"/label65536", func(t *testing.T) {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("65536-byte exporter label panicked (%v), want an error", r)
+				}
+			}()
+			if _, err := export(strings.Repeat("x", 65536), nil, 32); err == nil {
+				t.Fatal("65536-byte exporter label accepted, want rejection")
+			}
+		})
+		t.Run(tc.name+"/validLabel65535", func(t *testing.T) {
+			if got, err := export(strings.Repeat("x", 65535), nil, 32); err != nil || len(got) != 32 {
+				t.Fatalf("65535-byte exporter label = (%d bytes, %v), want success", len(got), err)
+			}
+		})
+		for _, length := range []int{-1, 0, 65536} {
+			t.Run(fmt.Sprintf("%s/output%d", tc.name, length), func(t *testing.T) {
+				if _, err := export("label", nil, length); err == nil {
+					t.Fatalf("exporter output length %d accepted, want rejection", length)
+				}
+			})
+		}
+	}
+}
