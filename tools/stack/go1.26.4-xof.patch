index 0000000..6694a2b
--- /dev/null
+++ b/src/crypto/tls/internal/tls13dec/injectivity_test.go
@@ -0,0 +1,256 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls13dec
+
+// These tests check finitely many derivation paths under one shared
+// input assignment. They do not prove framing injectivity. MAC now uses
+// the same dec engine as the rest of the schedule, so every observed
+// input, including the unkeyed transcript hashes, belongs to one pool.
+
+import (
+	"bytes"
+	"crypto/sha3"
+	"maps"
+	"slices"
+	"strings"
+	"testing"
+)
+
+type decCall struct {
+	seq []byte
+	out []byte
+}
+
+type recorder struct {
+	calls []decCall
+}
+
+// recordingXOF observes the actual production byte stream, including
+// cloned prefixes. Re-squeezing each recording independently checks that
+// no absorbed bytes were lost by the recorder.
+type recordingXOF struct {
+	inner xof
+	rec   *recorder
+	buf   []byte
+	read  bool
+}
+
+func (r *recordingXOF) Write(p []byte) (int, error) {
+	r.buf = append(r.buf, p...)
+	return r.inner.Write(p)
+}
+
+func (r *recordingXOF) Read(p []byte) (int, error) {
+	n, err := r.inner.Read(p)
+	if !r.read {
+		r.read = true
+		r.rec.calls = append(r.rec.calls, decCall{bytes.Clone(r.buf), bytes.Clone(p[:n])})
+	}
+	return n, err
+}
+
+func (r *recordingXOF) Reset() {
+	r.inner.Reset()
+	r.buf = nil
+	r.read = false
+}
+
+func (r *recordingXOF) clone() xof {
+	return &recordingXOF{r.inner.clone(), r.rec, bytes.Clone(r.buf), r.read}
+}
+
+func shadowProfile(p *Profile, rec *recorder) *Profile {
+	return &Profile{
+		newXOF: func() xof { return &recordingXOF{inner: p.newXOF(), rec: rec} },
+	}
+}
+
+var profileNames = map[*Profile]string{
+	SHAKE256:      "TLS13_SHAKE256",
+	TurboSHAKE256: "TLS13_TURBOSHAKE256",
+}
+
+type named struct {
+	name string
+	seq  []byte
+}
+
+type pool struct {
+	t       *testing.T
+	rec     *recorder
+	oneShot func([]byte, int) []byte
+	inputs  []named
+}
+
+func (pl *pool) step(name string, names []string, f func()) {
+	pl.t.Helper()
+	start := len(pl.rec.calls)
+	f()
+	calls := pl.rec.calls[start:]
+	if len(calls) != len(names) {
+		pl.t.Fatalf("%s: finalized %d sessions, want %d (%s)", name, len(calls), len(names), strings.Join(names, ", "))
+	}
+	for i, call := range calls {
+		full := name + "/" + names[i]
+		if got := pl.oneShot(call.seq, len(call.out)); !bytes.Equal(got, call.out) {
+			pl.t.Fatalf("%s: recorded input does not reproduce output: got %x, want %x", full, got, call.out)
+		}
+		pl.inputs = append(pl.inputs, named{full, call.seq})
+	}
+}
+
+// These entries intentionally reach the same derivation through
+// different entry points. No other repeated sequence is permitted.
+var byDesignGroups = [][]string{
+	{"ClientEarlyTrafficSecret/cet+ees", "EarlyExporterMasterSecret/cet+ees"},
+	{"ResumptionBinderKey/rbk", "PSKOnlyHandshake/rbk"},
+}
+
+var collapsed = bytes.Repeat([]byte{0xA5}, SecretSize)
+
+func walk(t *testing.T, p *Profile, oneShot func([]byte, int) []byte) *pool {
+	t.Helper()
+	rec := &recorder{}
+	sp := shadowProfile(p, rec)
+	pl := &pool{t: t, rec: rec, oneShot: oneShot}
+	k := collapsed
+	var e *EarlyStage
+	pl.step("NewEarlyStage", nil, func() { e = NewEarlyStage(sp, k) })
+	pl.step("ClientEarlyTrafficSecret", []string{"cet+ees"}, func() { e.ClientEarlyTrafficSecret(k) })
+	pl.step("EarlyExporterMasterSecret", []string{"cet+ees"}, func() { e.EarlyExporterMasterSecret(k) })
+	pl.step("ResumptionBinderKey", []string{"rbk"}, func() { e.BinderKey(false) })
+	pl.step("ImportedBinderKey", []string{"ibk"}, func() { e.BinderKey(true) })
+	var h *HandshakeStage
+	pl.step("Handshake", nil, func() { h = e.Handshake(k, k) })
+	pl.step("ClientHandshakeTrafficSecret", []string{"cht"}, func() { h.ClientHandshakeTrafficSecret() })
+	pl.step("ServerHandshakeTrafficSecret", nil, func() { h.ServerHandshakeTrafficSecret() })
+	var a *AppStage
+	pl.step("Application", []string{"drv"}, func() { a = h.Application(k) })
+	pl.step("ClientApplicationTrafficSecret", []string{"cat"}, func() { a.ClientApplicationTrafficSecret() })
+	pl.step("ServerApplicationTrafficSecret", nil, func() { a.ServerApplicationTrafficSecret() })
+	pl.step("ExporterMasterSecret", nil, func() { a.ExporterMasterSecret() })
+	pl.step("ResumptionMasterSecret", []string{"rss"}, func() { a.ResumptionMasterSecret(k) })
+	pl.step("PSKOnlyHandshake", []string{"rbk", "cht"}, func() {
+		NewEarlyStage(sp, k).Handshake(nil, k).ClientHandshakeTrafficSecret()
+	})
+
+	// Retained-secret operations are deliberately keyed identically so
+	// their labels and lengths must separate them.
+	pl.step("TrafficKeys(Nk=16)", []string{"key"}, func() { sp.TrafficKeys(k, 16, 12) })
+	pl.step("TrafficKeys(Nk=32)", []string{"key"}, func() { sp.TrafficKeys(k, 32, 12) })
+	pl.step("ApplicationKeys", []string{"upd+key"}, func() { sp.ApplicationKeys(k, 16, 12) })
+	pl.step("ResumptionPSK", []string{"rsp"}, func() { sp.ResumptionPSK(k, k) })
+	pl.step("ResumptionPSK(empty nonce)", []string{"rsp"}, func() { sp.ResumptionPSK(k, nil) })
+	// Only context is hashed; the exporter label is framed raw.
+	pl.step("Exporter", []string{"exl", "TranscriptHash(context)", "exp"}, func() {
+		sp.Exporter(k, "EXPORTER-distinctness", []byte("distinctness context"), 32)
+	})
+	pl.step("Exporter(empty context)", []string{"exl", "TranscriptHash(context)", "exp"}, func() {
+		sp.Exporter(k, "EXPORTER-distinctness-empty", nil, 32)
+	})
+	pl.step("ImportPSK", []string{"TranscriptHash(ImportedIdentity)", "ipk"}, func() {
+		sp.ImportPSK(k, []byte("distinctness ImportedIdentity serialization"))
+	})
+	pl.step("Finished", []string{"fin", "mac"}, func() { sp.Finished(k, k) })
+	pl.step("ECHAcceptConfirmation", []string{"eca"}, func() { sp.ECHAcceptConfirmation(k, k) })
+	pl.step("ECHHRRAcceptConfirmation", []string{"hca"}, func() { sp.ECHHRRAcceptConfirmation(k, k) })
+	pl.step("TranscriptHash", []string{"one-shot"}, func() {
+		sp.TranscriptHash([]byte("distinctness: one-shot transcript"))
+	})
+	pl.step("NewTranscriptHash", []string{"incremental"}, func() {
+		h := sp.NewTranscriptHash()
+		h.Write([]byte("distinctness: incremental transcript"))
+		h.Sum(nil)
+	})
+	return pl
+}
+
+func group(entries []named) map[string][]string {
+	g := map[string][]string{}
+	for _, e := range entries {
+		g[string(e.seq)] = append(g[string(e.seq)], e.name)
+	}
+	for _, names := range g {
+		slices.Sort(names)
+	}
+	return g
+}
+
+func key(names []string) string { return strings.Join(names, " == ") }
+
+func checkDistinct(t *testing.T, entries []named, allowed [][]string) {
+	t.Helper()
+	want := map[string]bool{}
+	for _, g := range allowed {
+		names := slices.Clone(g)
+		slices.Sort(names)
+		want[key(names)] = true
+	}
+	groups, seen := group(entries), map[string]bool{}
+	for _, k := range slices.Sorted(maps.Keys(groups)) {
+		names := groups[k]
+		if len(names) == 1 {
+			continue
+		}
+		if want[key(names)] {
+			seen[key(names)] = true
+			continue
+		}
+		t.Errorf("unexpected equal derivation inputs: %s\n  %x", key(names), k)
+	}
+	for name := range want {
+		if !seen[name] {
+			t.Errorf("required equal derivation inputs no longer agree: %s", name)
+		}
+	}
+}
+
+func profiles() []struct {
+	name    string
+	profile *Profile
+	oneShot func([]byte, int) []byte
+} {
+	return []struct {
+		name    string
+		profile *Profile
+		oneShot func([]byte, int) []byte
+	}{
+		{"TurboSHAKE256", TurboSHAKE256, func(seq []byte, n int) []byte {
+			return sumTurboSHAKE256(seq, n)
+		}},
+		{"SHAKE256", SHAKE256, func(seq []byte, n int) []byte {
+			return sha3.SumSHAKE256(seq, n)
+		}},
+	}
+}
+
+func TestDerivationSequencesDistinct(t *testing.T) {
+	for _, tc := range profiles() {
+		t.Run(tc.name, func(t *testing.T) {
+			pl := walk(t, tc.profile, tc.oneShot)
+			t.Logf("%d XOF inputs, including all MAC and transcript-hash inputs", len(pl.inputs))
+			checkDistinct(t, pl.inputs, byDesignGroups)
+		})
+	}
+}
+
+// Separate profile instances using the same XOF produce identical framing.
+func TestFramingIgnoresProfileIdentity(t *testing.T) {
+	for _, tc := range profiles() {
+		t.Run(tc.name, func(t *testing.T) {
+			twin := &Profile{newXOF: tc.profile.newXOF}
+			real, twinned := walk(t, tc.profile, tc.oneShot), walk(t, twin, tc.oneShot)
+			if len(real.inputs) != len(twinned.inputs) {
+				t.Fatal("profile identity changed the number of derivations")
+			}
+			for i, entry := range real.inputs {
+				other := twinned.inputs[i]
+				if entry.name != other.name || !bytes.Equal(entry.seq, other.seq) {
+					t.Errorf("%s frames differently in a separate profile instance", entry.name)
+				}
+			}
+		})
+	}
+}
diff --git a/src/crypto/tls/internal/tls13dec/permcount_test.go b/src/crypto/tls/internal/tls13dec/permcount_test.go
new file mode 100644
index 0000000..5bd3c86
--- /dev/null
+++ b/src/crypto/tls/internal/tls13dec/permcount_test.go
@@ -0,0 +1,63 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls13dec
+
+import "testing"
+
+// Apply the draft's standalone counting rule to the recorded production
+// inputs and outputs: floor(n/136) + 1 + ceil(L/136) - 1. The recorder
+// includes cloned prefixes and the full output length of each DeriveN tuple.
+func permutationCount(calls []decCall) int {
+	total := 0
+	for _, call := range calls {
+		total += len(call.seq)/136 + (len(call.out)+135)/136
+	}
+	return total
+}
+
+// Count each fixed tuple once, retaining its other outputs for later use.
+// Transcript hashing is excluded from the draft's schedule comparison.
+func TestPermCountRepresentativeHandshake(t *testing.T) {
+	for _, p := range []*Profile{SHAKE256, TurboSHAKE256} {
+		t.Run(profileNames[p], func(t *testing.T) {
+			rec := &recorder{}
+			p := shadowProfile(p, rec)
+			psk, shared := make([]byte, 64), make([]byte, 32)
+			th, nonce := make([]byte, 64), make([]byte, 8)
+			e := NewEarlyStage(p, psk)
+			rbk := e.BinderKey(false)
+			p.Finished(rbk, th)
+			early := e.earlyTraffic(th)
+			p.TrafficKeys(early[0], 16, 12)
+			h := e.Handshake(shared, th)
+			cht, sht := h.ClientHandshakeTrafficSecret(), h.ServerHandshakeTrafficSecret()
+			cfk, _, _ := p.HandshakeKeys(cht, 16, 12)
+			sfk, _, _ := p.HandshakeKeys(sht, 16, 12)
+			p.mac(cfk, th, MACSize)
+			p.mac(sfk, th, MACSize)
+			a := h.Application(th)
+			cat, sat, exs := a.ClientApplicationTrafficSecret(), a.ServerApplicationTrafficSecret(), a.ExporterMasterSecret()
+			rss := a.ResumptionMasterSecret(th)
+			cat1, _, _ := p.ApplicationKeys(cat, 16, 12)
+			sat1, _, _ := p.ApplicationKeys(sat, 16, 12)
+			if got := permutationCount(rec.calls); got != 23 {
+				t.Fatalf("handshake used %d permutations, want 23", got)
+			}
+			if len(rec.calls) != 15 {
+				t.Fatalf("handshake used %d XOF calls, want 15", len(rec.calls))
+			}
+			t.Logf("handshake: %d XOF calls, %d permutations", len(rec.calls), permutationCount(rec.calls))
+			p.ApplicationKeys(cat1, 16, 12)
+			p.ApplicationKeys(sat1, 16, 12)
+			p.ResumptionPSK(rss, nonce)
+			// Prehashed context isolates the two exporter derivations.
+			exl := p.expand(exs, "exl", []byte("test label"), 64)
+			p.expand(exl, "exp", th, 32)
+			if got := permutationCount(rec.calls); got != 29 {
+				t.Fatalf("schedule used %d permutations, want 29", got)
+			}
+		})
+	}
+}
diff --git a/src/crypto/tls/internal/tls13dec/permrecompute_test.go b/src/crypto/tls/internal/tls13dec/permrecompute_test.go
new file mode 100644
index 0000000..207ead4
--- /dev/null
+++ b/src/crypto/tls/internal/tls13dec/permrecompute_test.go
@@ -0,0 +1,66 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls13dec
+
+import (
+	"bytes"
+	"testing"
+)
+
+// Rebuild the full DeriveN input independently of the accumulator API.
+func recomputeTuple(p *Profile, trunk, th []byte, labels ...string) [][]byte {
+	seq := bytes.Clone(trunk)
+	if len(th) != 0 {
+		seq = append(seq, framedSequence([]byte("th__"), th)...)
+	}
+	seq = append(seq, framedSequence([]byte("outs"), []byte{0, byte(len(labels))})...)
+	for _, label := range labels {
+		seq = append(seq, framedSequence([]byte(label), []byte("out_"), []byte{0, 64})...)
+	}
+	x := p.newXOF()
+	x.Write(seq)
+	buf := make([]byte, 64*len(labels))
+	x.Read(buf)
+	out := make([][]byte, len(labels))
+	for i := range out {
+		out[i] = buf[i*64 : (i+1)*64]
+	}
+	return out
+}
+
+func TestRecomputeTuples(t *testing.T) {
+	for _, p := range []*Profile{SHAKE256, TurboSHAKE256} {
+		psk, shared, th := ptn(64), ptn(32), ptn(64)
+		eTrunk := framedSequence([]byte("tls13 "), []byte("psk_"), psk)
+		early := recomputeTuple(p, eTrunk, th, "cet", "ees")
+		binder := recomputeTuple(p, eTrunk, nil, "rbk", "drv")
+		e := NewEarlyStage(p, psk)
+		check := func(got, want []byte) {
+			t.Helper()
+			if !bytes.Equal(got, want) {
+				t.Fatalf("%s: independent tuple differs", profileNames[p])
+			}
+		}
+		check(e.ClientEarlyTrafficSecret(th), early[0])
+		check(e.EarlyExporterMasterSecret(th), early[1])
+		check(e.BinderKey(false), binder[0])
+		hTrunk := framedSequence([]byte("tls13 "), []byte("seed"), binder[1], []byte("shs_"), shared)
+		hs := recomputeTuple(p, hTrunk, th, "cht", "sht")
+		h := e.Handshake(shared, th)
+		check(h.ClientHandshakeTrafficSecret(), hs[0])
+		check(h.ServerHandshakeTrafficSecret(), hs[1])
+		seq := append(hTrunk, framedSequence([]byte("drv"), []byte("out_"), []byte{0, 64})...)
+		x := p.newXOF()
+		x.Write(seq)
+		seed := make([]byte, 64)
+		x.Read(seed)
+		tTrunk := framedSequence([]byte("tls13 "), []byte("seed"), seed)
+		app := recomputeTuple(p, tTrunk, th, "cat", "sat", "exs")
+		a := h.Application(th)
+		check(a.ClientApplicationTrafficSecret(), app[0])
+		check(a.ServerApplicationTrafficSecret(), app[1])
+		check(a.ExporterMasterSecret(), app[2])
+	}
+}
diff --git a/src/crypto/tls/internal/tls13dec/schedule.go b/src/crypto/tls/internal/tls13dec/schedule.go
new file mode 100644
index 0000000..b9f96d7
--- /dev/null
+++ b/src/crypto/tls/internal/tls13dec/schedule.go
@@ -0,0 +1,235 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls13dec
+
+import "bytes"
+
+// EarlyStage is the early trunk, keyed by the PSK. With no PSK, the
+// psk_ item is still present, with an empty value.
+type EarlyStage struct {
+	e       *decEngine
+	psk     bool
+	residue []byte
+}
+
+func NewEarlyStage(p *Profile, psk []byte) *EarlyStage {
+	st := p.initEngine()
+	st.absorb("psk_", psk)
+	return &EarlyStage{e: st, psk: len(psk) != 0}
+}
+
+// ClientEarlyTrafficSecret derives cet with TH_CH at the leaf.
+func (e *EarlyStage) ClientEarlyTrafficSecret(th []byte) []byte {
+	return e.earlyTraffic(th)[0]
+}
+
+// EarlyExporterMasterSecret derives early_exporter_secret.
+func (e *EarlyStage) EarlyExporterMasterSecret(th []byte) []byte {
+	return e.earlyTraffic(th)[1]
+}
+
+func (e *EarlyStage) earlyTraffic(th []byte) [][]byte {
+	return e.e.deriveN([]output{{"cet", SecretSize}, {"ees", SecretSize}}, "th__", th)
+}
+
+// BinderKey derives the binder and the residue that seeds the handshake.
+// Both outputs depend on the selected PSK kind.
+func (e *EarlyStage) BinderKey(imported bool) []byte {
+	label := "rbk"
+	if imported {
+		label = "ibk"
+	}
+	return e.binderKey(label)
+}
+
+func (e *EarlyStage) binderKey(label string) []byte {
+	values := e.e.deriveN([]output{{label, SecretSize}, {"drv", SecretSize}}, "", nil)
+	clear(e.residue)
+	e.residue = values[1]
+	return values[0]
+}
+
+func (e *EarlyStage) destroy() {
+	e.e.destroy()
+	clear(e.residue)
+	e.residue = nil
+}
+
+// Handshake seeds the handshake stage and absorbs one shared secret.
+// An absent shared secret (PSK-only) omits the shs_ item.
+func (e *EarlyStage) Handshake(dhe, th []byte) *HandshakeStage {
+	var components [][]byte
+	if len(dhe) != 0 {
+		components = [][]byte{dhe}
+	}
+	return e.HandshakeComponents(components, th)
+}
+
+// HandshakeComponents absorbs each component separately in the order
+// defined by the negotiated group. Components must not be concatenated.
+func (e *EarlyStage) HandshakeComponents(components [][]byte, th []byte) *HandshakeStage {
+	var st *decEngine
+	if e.psk {
+		if e.residue == nil {
+			clear(e.BinderKey(false))
+		}
+		st = e.e.p.initEngine(e.residue)
+		e.destroy()
+	} else {
+		st = e.e.ratchet()
+	}
+	for _, component := range components {
+		st.absorb("shs_", component)
+	}
+	return &HandshakeStage{h: st, th: bytes.Clone(th)}
+}
+
+// HandshakeStage holds the transcript-free handshake trunk. th is a
+// checkpoint for its traffic-secret leaves, not part of the trunk.
+type HandshakeStage struct {
+	h      *decEngine
+	th     []byte
+	leaves [][]byte
+}
+
+func (h *HandshakeStage) ClientHandshakeTrafficSecret() []byte {
+	return bytes.Clone(h.traffic()[0])
+}
+
+func (h *HandshakeStage) ServerHandshakeTrafficSecret() []byte {
+	return bytes.Clone(h.traffic()[1])
+}
+
+func (h *HandshakeStage) traffic() [][]byte {
+	if h.h.x == nil {
+		panic("tls13dec: retired handshake")
+	}
+	if h.leaves == nil {
+		h.leaves = h.h.deriveN([]output{{"cht", SecretSize}, {"sht", SecretSize}}, "th__", h.th)
+	}
+	return h.leaves
+}
+
+// Application ratchets H without absorbing its leaf checkpoint.
+func (h *HandshakeStage) Application(th []byte) *AppStage {
+	st := h.h.ratchet()
+	h.th = nil
+	for _, leaf := range h.leaves {
+		clear(leaf)
+	}
+	h.leaves = nil
+	return &AppStage{t: st, th: bytes.Clone(th)}
+}
+
+// AppStage holds the transcript-free application trunk. TH_SF applies
+// only to the application traffic and exporter leaves; rss uses TH_CF.
+type AppStage struct {
+	t      *decEngine
+	th     []byte
+	leaves [][]byte
+}
+
+func (t *AppStage) ClientApplicationTrafficSecret() []byte {
+	return bytes.Clone(t.traffic()[0])
+}
+
+func (t *AppStage) ServerApplicationTrafficSecret() []byte {
+	return bytes.Clone(t.traffic()[1])
+}
+
+func (t *AppStage) ExporterMasterSecret() []byte {
+	return bytes.Clone(t.traffic()[2])
+}
+
+func (t *AppStage) traffic() [][]byte {
+	if t.t.x == nil {
+		panic("tls13dec: retired application")
+	}
+	if t.leaves == nil {
+		t.leaves = t.t.deriveN([]output{{"cat", SecretSize}, {"sat", SecretSize}, {"exs", SecretSize}}, "th__", t.th)
+	}
+	return t.leaves
+}
+
+// ResumptionMasterSecret derives rss and retires the application trunk.
+func (t *AppStage) ResumptionMasterSecret(th []byte) []byte {
+	out := t.t.derive("rss", "th__", th, SecretSize)
+	t.t.destroy()
+	t.th = nil
+	for _, leaf := range t.leaves {
+		clear(leaf)
+	}
+	t.leaves = nil
+	return out
+}
+
+// TrafficKeys derives one key block and splits it into a key and IV.
+func (p *Profile) TrafficKeys(secret []byte, keyLen, ivLen int) (key, iv []byte) {
+	block := p.expand(secret, "key", nil, keyLen+ivLen)
+	return block[:keyLen], block[keyLen:]
+}
+
+// HandshakeKeys derives the Finished key and record material as one tuple.
+func (p *Profile) HandshakeKeys(secret []byte, keyLen, ivLen int) (finished, key, iv []byte) {
+	return p.recordKeys(secret, "fin", keyLen, ivLen)
+}
+
+// ApplicationKeys derives the next traffic secret with this epoch's records.
+func (p *Profile) ApplicationKeys(secret []byte, keyLen, ivLen int) (next, key, iv []byte) {
+	return p.recordKeys(secret, "upd", keyLen, ivLen)
+}
+
+func (p *Profile) recordKeys(secret []byte, label string, keyLen, ivLen int) (extra, key, iv []byte) {
+	d := p.initEngine(secret)
+	defer d.destroy()
+	values := d.deriveN([]output{{label, SecretSize}, {"key", keyLen + ivLen}}, "", nil)
+	return values[0], values[1][:keyLen], values[1][keyLen:]
+}
+
+func (p *Profile) ResumptionPSK(secret, nonce []byte) []byte {
+	return p.expand(secret, "rsp", nonce, SecretSize)
+}
+
+// Exporter first derives a label secret, then binds the context hash.
+// The TLS caller validates the label and output lengths before calling here.
+func (p *Profile) Exporter(secret []byte, label string, context []byte, length int) []byte {
+	labelSecret := p.expand(secret, "exl", []byte(label), SecretSize)
+	defer clear(labelSecret)
+	return p.expand(labelSecret, "exp", p.TranscriptHash(context), length)
+}
+
+// ImportPSK binds the complete RFC 9258 ImportedIdentity via its hash.
+func (p *Profile) ImportPSK(epsk, importedIdentity []byte) []byte {
+	return p.expand(epsk, "ipk", p.TranscriptHash(importedIdentity), SecretSize)
+}
+
+// Finished derives a dedicated fin key before computing the mac leaf.
+// The base key is a binder key, or a post-handshake authentication base key.
+// Handshake Finished uses the fin output of HandshakeKeys instead.
+func (p *Profile) Finished(baseKey, th []byte) []byte {
+	finishedKey := p.expand(baseKey, "fin", nil, SecretSize)
+	out := p.mac(finishedKey, th, MACSize)
+	clear(finishedKey)
+	return out
+}
+
+// HandshakeFinished uses the Finished key paired with the record key block.
+func (p *Profile) HandshakeFinished(secret, th []byte, keyLen, ivLen int) []byte {
+	finished, key, iv := p.HandshakeKeys(secret, keyLen, ivLen)
+	defer clear(finished)
+	clear(key)
+	clear(iv)
+	return p.mac(finished, th, MACSize)
+}
+
+// ECH acceptance confirmations are separate retained-secret derivations,
+// with the ClientHelloInner.random as seed and the transcript as context.
+func (p *Profile) ECHAcceptConfirmation(innerRandom, th []byte) []byte {
+	return p.expand(innerRandom, "eca", th, 8)
+}
+
+func (p *Profile) ECHHRRAcceptConfirmation(innerRandom, th []byte) []byte {
+	return p.expand(innerRandom, "hca", th, 8)
+}
diff --git a/src/crypto/tls/internal/tls13dec/schedule_test.go b/src/crypto/tls/internal/tls13dec/schedule_test.go
new file mode 100644
index 0000000..1dc09e6
--- /dev/null
+++ b/src/crypto/tls/internal/tls13dec/schedule_test.go
@@ -0,0 +1,288 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls13dec
+
+import (
+	"bytes"
+	"testing"
+)
+
+// ptn returns n bytes of the repeating pattern 0x00..0xFA.
+func ptn(n int) []byte {
+	p := make([]byte, n)
+	for i := range p {
+		p[i] = byte(i % 0xFB)
+	}
+	return p
+}
+
+func frameBytes(v []byte) []byte {
+	return append([]byte{byte(len(v) >> 8), byte(len(v))}, v...)
+}
+
+func frameStr(s string) []byte { return frameBytes([]byte(s)) }
+
+// framedSequence independently spells the sequence of frame items in
+// the draft. It deliberately does not use the production frame helper.
+func framedSequence(items ...[]byte) []byte {
+	var out []byte
+	for _, item := range items {
+		out = append(out, frameBytes(item)...)
+	}
+	return out
+}
+
+func TestDerivationExample(t *testing.T) {
+	for _, tc := range profiles() {
+		t.Run(tc.name, func(t *testing.T) {
+			// The no-PSK early trunk still absorbs an empty psk_ item.
+			// The binder is an early leaf, with no ratchet or context.
+			seq := framedSequence([]byte("tls13 "), []byte("psk_"), nil,
+				[]byte("outs"), []byte{0, 2}, []byte("rbk"), []byte("out_"), []byte{0, 64},
+				[]byte("drv"), []byte("out_"), []byte{0, 64})
+			want := tc.oneShot(seq, 128)[:64]
+			if got := NewEarlyStage(tc.profile, nil).BinderKey(false); !bytes.Equal(got, want) {
+				t.Errorf("no-PSK binder key = %x, want %x", got, want)
+			}
+		})
+	}
+}
+
+func TestExpandFraming(t *testing.T) {
+	for _, tc := range profiles() {
+		t.Run(tc.name, func(t *testing.T) {
+			secret := bytes.Repeat([]byte{3}, 64)
+			seq := framedSequence([]byte("tls13 "), []byte("seed"), secret,
+				[]byte("key"), []byte("out_"), []byte{0, 28})
+			want := tc.oneShot(seq, 28)
+			key, iv := tc.profile.TrafficKeys(secret, 16, 12)
+			if got := append(bytes.Clone(key), iv...); !bytes.Equal(got, want) {
+				t.Errorf("record key block = %x, want %x", got, want)
+			}
+			block44 := tc.profile.expand(secret, "key", nil, 44)
+			if bytes.Equal(want, block44[:28]) {
+				t.Error("different output lengths produced related prefixes")
+			}
+		})
+	}
+}
+
+// TestMACConstruction pins MAC to the same seeded dec engine construction as
+// every other retained-secret derivation. The context precedes mac.
+func TestMACConstruction(t *testing.T) {
+	for _, tc := range profiles() {
+		t.Run(tc.name, func(t *testing.T) {
+			baseKey := bytes.Repeat([]byte{9}, 64)
+			th := tc.profile.TranscriptHash([]byte("transcript"))
+			fkSeq := framedSequence([]byte("tls13 "), []byte("seed"), baseKey,
+				[]byte("fin"), []byte("out_"), []byte{0, 64})
+			fk := tc.oneShot(fkSeq, 64)
+			macSeq := framedSequence([]byte("tls13 "), []byte("seed"), fk,
+				[]byte("ctx_"), th, []byte("mac"), []byte("out_"), []byte{0, 64})
+			want := tc.oneShot(macSeq, 64)
+			if got := tc.profile.Finished(baseKey, th); !bytes.Equal(got, want) {
+				t.Errorf("Finished = %x, want %x", got, want)
+			}
+		})
+	}
+}
+
+func TestExporterRawLabel(t *testing.T) {
+	for _, tc := range profiles() {
+		t.Run(tc.name, func(t *testing.T) {
+			key := bytes.Repeat([]byte{7}, 64)
+			labelSeq := framedSequence([]byte("tls13 "), []byte("seed"), key,
+				[]byte("ctx_"), []byte("test label"), []byte("exl"), []byte("out_"), []byte{0, 64})
+			labelSecret := tc.oneShot(labelSeq, 64)
+			seq := framedSequence([]byte("tls13 "), []byte("seed"), labelSecret,
+				[]byte("ctx_"), tc.profile.TranscriptHash([]byte("context")), []byte("exp"), []byte("out_"), []byte{0, 32})
+			if got, want := tc.profile.Exporter(key, "test label", []byte("context"), 32), tc.oneShot(seq, 32); !bytes.Equal(got, want) {
+				t.Errorf("exporter = %x, want %x", got, want)
+			}
+		})
+	}
+}
+
+func TestProfilesDiffer(t *testing.T) {
+	secret := bytes.Repeat([]byte{7}, 64)
+	tk, _ := TurboSHAKE256.TrafficKeys(secret, 16, 12)
+	sk, _ := SHAKE256.TrafficKeys(secret, 16, 12)
+	if bytes.Equal(tk, sk) {
+		t.Error("profiles produced identical record keys")
+	}
+	if bytes.Equal(TurboSHAKE256.TranscriptHash([]byte("x")), SHAKE256.TranscriptHash([]byte("x"))) {
+		t.Error("profile transcript hashes coincide")
+	}
+}
+
+// PSK-only omits shs_ altogether, rather than absorbing an empty item.
+func TestPSKOnlyOmitsSharedSecret(t *testing.T) {
+	for _, tc := range profiles() {
+		p := tc.profile
+		psk, th := ptn(64), p.TranscriptHash([]byte("x"))
+		a := NewEarlyStage(p, psk).Handshake(nil, th).ServerHandshakeTrafficSecret()
+		b := NewEarlyStage(p, psk).Handshake([]byte{}, th).ServerHandshakeTrafficSecret()
+		if !bytes.Equal(a, b) {
+			t.Errorf("%s: nil and empty shared secrets disagree", tc.name)
+		}
+		st := NewEarlyStage(p, psk).e.ratchet()
+		st.absorb("shs_", nil)
+		if bytes.Equal(a, st.derive("sht", "th__", th, SecretSize)) {
+			t.Errorf("%s: PSK-only absorbed an empty shs_ item", tc.name)
+		}
+	}
+}
+
+func TestTranscriptHash(t *testing.T) {
+	for _, p := range []*Profile{TurboSHAKE256, SHAKE256} {
+		msg := ptn(500)
+		want := p.TranscriptHash(msg)
+		if len(want) != 64 {
+			t.Fatalf("length %d", len(want))
+		}
+		h := p.NewTranscriptHash()
+		h.Write(msg[:100])
+		h.Write(msg[100:])
+		if got := h.Sum(nil); !bytes.Equal(got, want) {
+			t.Errorf("incremental = %x, want %x", got, want)
+		}
+		h2 := p.NewTranscriptHash()
+		h2.Write(msg[:100])
+		_ = h2.Sum(nil)
+		h2.Write(msg[100:])
+		if got := h2.Sum(nil); !bytes.Equal(got, want) {
+			t.Errorf("Sum disturbed decEngine: %x, want %x", got, want)
+		}
+	}
+}
+
+func TestLeavesSuiteIndependent(t *testing.T) {
+	psk := bytes.Repeat([]byte{1}, 64)
+	th := TurboSHAKE256.TranscriptHash([]byte("ch"))
+	e := NewEarlyStage(TurboSHAKE256, psk)
+	a := e.ClientEarlyTrafficSecret(th)
+	if c := e.ClientEarlyTrafficSecret(th); !bytes.Equal(a, c) {
+		t.Error("derive disturbed the trunk")
+	}
+	k16, _ := TurboSHAKE256.TrafficKeys(a, 16, 12)
+	k32, _ := TurboSHAKE256.TrafficKeys(a, 32, 12)
+	if bytes.Equal(k16, k32[:16]) {
+		t.Error("record keys of different lengths share a prefix")
+	}
+}
+
+func mustPanic(t *testing.T, f func()) {
+	t.Helper()
+	defer func() {
+		if recover() == nil {
+			t.Error("invalid operation did not panic")
+		}
+	}()
+	f()
+}
+
+func TestRetiredStages(t *testing.T) {
+	for _, tc := range profiles() {
+		t.Run(tc.name, func(t *testing.T) {
+			e := NewEarlyStage(tc.profile, ptn(64))
+			h := e.Handshake(ptn(32), ptn(64))
+			mustPanic(t, func() { e.BinderKey(false) })
+			mustPanic(t, func() { e.e.absorb("psk_", nil) })
+			mustPanic(t, func() { e.Handshake(nil, nil) })
+			a := h.Application(ptn(64))
+			mustPanic(t, func() { h.ClientHandshakeTrafficSecret() })
+			mustPanic(t, func() { h.Application(nil) })
+			a.ResumptionMasterSecret(ptn(64))
+			mustPanic(t, func() { a.ClientApplicationTrafficSecret() })
+			mustPanic(t, func() { a.ResumptionMasterSecret(nil) })
+		})
+	}
+}
+
+// Transcript checkpoints belong to leaves, not trunks or ratchet
+// residues. Changing a checkpoint changes its leaves but not later
+// leaves that use an identical checkpoint of their own.
+func TestTranscriptFreeRatchets(t *testing.T) {
+	for _, tc := range profiles() {
+		t.Run(tc.name, func(t *testing.T) {
+			p := tc.profile
+			psk, shared := ptn(64), ptn(32)
+			th1, th2 := bytes.Repeat([]byte{1}, 64), bytes.Repeat([]byte{2}, 64)
+			h1 := NewEarlyStage(p, psk).Handshake(shared, th1)
+			h2 := NewEarlyStage(p, psk).Handshake(shared, th2)
+			if bytes.Equal(h1.ClientHandshakeTrafficSecret(), h2.ClientHandshakeTrafficSecret()) {
+				t.Error("handshake traffic failed to bind TH_SH")
+			}
+			a1, a2 := h1.Application(th1), h2.Application(th1)
+			if !bytes.Equal(a1.ClientApplicationTrafficSecret(), a2.ClientApplicationTrafficSecret()) {
+				t.Error("TH_SH leaked into the H-to-T ratchet")
+			}
+			a3 := NewEarlyStage(p, psk).Handshake(shared, th1).Application(th2)
+			if bytes.Equal(a1.ClientApplicationTrafficSecret(), a3.ClientApplicationTrafficSecret()) {
+				t.Error("application traffic failed to bind TH_SF")
+			}
+			if !bytes.Equal(a1.ResumptionMasterSecret(th1), a3.ResumptionMasterSecret(th1)) {
+				t.Error("TH_SF leaked into the resumption leaf")
+			}
+		})
+	}
+}
+
+func TestCheckpointOwnership(t *testing.T) {
+	for _, tc := range profiles() {
+		p := tc.profile
+		th := ptn(64)
+		h := NewEarlyStage(p, ptn(64)).Handshake(ptn(32), th)
+		want := h.ClientHandshakeTrafficSecret()
+		th[0] ^= 1
+		if !bytes.Equal(want, h.ClientHandshakeTrafficSecret()) {
+			t.Errorf("%s: caller mutation changed stored TH_SH", tc.name)
+		}
+		a := h.Application(th)
+		want = a.ClientApplicationTrafficSecret()
+		th[0] ^= 1
+		if !bytes.Equal(want, a.ClientApplicationTrafficSecret()) {
+			t.Errorf("%s: caller mutation changed stored TH_SF", tc.name)
+		}
+	}
+}
+
+func TestSharedSecretComponents(t *testing.T) {
+	for _, tc := range profiles() {
+		t.Run(tc.name, func(t *testing.T) {
+			p := tc.profile
+			psk := ptn(64)
+			first, second := ptn(32), bytes.Repeat([]byte{0xA7}, 64)
+			th := p.TranscriptHash([]byte("ServerHello"))
+			// The hybrid path has a separate shs_ item for each
+			// component, in the group's prescribed order.
+			eSeq := framedSequence([]byte("tls13 "), []byte("psk_"), psk,
+				[]byte("outs"), []byte{0, 2}, []byte("rbk"), []byte("out_"), []byte{0, 64},
+				[]byte("drv"), []byte("out_"), []byte{0, 64})
+			seed := tc.oneShot(eSeq, 2*SecretSize)[SecretSize:]
+			hSeq := framedSequence([]byte("tls13 "), []byte("seed"), seed,
+				[]byte("shs_"), first, []byte("shs_"), second,
+				[]byte("th__"), th, []byte("outs"), []byte{0, 2},
+				[]byte("cht"), []byte("out_"), []byte{0, 64}, []byte("sht"), []byte("out_"), []byte{0, 64})
+			h := NewEarlyStage(p, psk).HandshakeComponents([][]byte{first, second}, th)
+			got := h.ClientHandshakeTrafficSecret()
+			if want := tc.oneShot(hSeq, 2*SecretSize)[:SecretSize]; !bytes.Equal(got, want) {
+				t.Errorf("component framing = %x, want %x", got, want)
+			}
+			joined := append(bytes.Clone(first), second...)
+			if bytes.Equal(got, NewEarlyStage(p, psk).Handshake(joined, th).ClientHandshakeTrafficSecret()) {
+				t.Error("component boundaries were lost")
+			}
+			if bytes.Equal(got, NewEarlyStage(p, psk).HandshakeComponents([][]byte{second, first}, th).ClientHandshakeTrafficSecret()) {
+				t.Error("component order was lost")
+			}
+			otherTH := p.TranscriptHash([]byte("another ServerHello"))
+			other := NewEarlyStage(p, psk).HandshakeComponents([][]byte{first, second}, otherTH)
+			if !bytes.Equal(h.Application(th).ClientApplicationTrafficSecret(), other.Application(th).ClientApplicationTrafficSecret()) {
+				t.Error("hybrid TH_SH leaked into the H-to-T ratchet")
+			}
+		})
+	}
+}
