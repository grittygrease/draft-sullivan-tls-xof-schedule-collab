diff --git a/src/crypto/tls/internal/tls13dec/turboshake.go b/src/crypto/tls/internal/tls13dec/turboshake.go
new file mode 100644
index 0000000..7a615ca
--- /dev/null
+++ b/src/crypto/tls/internal/tls13dec/turboshake.go
@@ -0,0 +1,125 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls13dec
+
+import "math/bits"
+
+// TurboSHAKE256 uses the last twelve Keccak-f[1600] rounds (RFC 9861).
+// draft-sullivan-tls-xof-schedule fixes its rate to 136 octets and its
+// domain separation byte to 0x1F.
+const turboSHAKE256Rate = 136
+
+// rc12 holds the round constants of rounds 12 through 23 of
+// Keccak-f[1600]; Keccak-p[1600,12] applies exactly these rounds
+// (FIPS 202, Section 3.3; RFC 9861, Section 1).
+var rc12 = [12]uint64{
+	0x000000008000808B,
+	0x800000000000008B,
+	0x8000000000008089,
+	0x8000000000008003,
+	0x8000000000008002,
+	0x8000000000000080,
+	0x000000000000800A,
+	0x800000008000000A,
+	0x8000000080008081,
+	0x8000000000008080,
+	0x0000000080000001,
+	0x8000000080008008,
+}
+
+// rho holds the ρ-step rotation offsets, indexed by lane x+5y.
+var rho = [25]int{
+	0, 1, 62, 28, 27,
+	36, 44, 6, 55, 20,
+	3, 10, 43, 25, 39,
+	41, 45, 15, 21, 8,
+	18, 2, 61, 56, 14,
+}
+
+// keccakP1600x12 applies Keccak-p[1600,12] to the state, lane A[x][y]
+// stored at a[x+5y] with little-endian byte order within each lane.
+func keccakP1600x12(a *[25]uint64) {
+	var b [25]uint64
+	var c, d [5]uint64
+	for r := 0; r < 12; r++ {
+		// θ
+		for x := 0; x < 5; x++ {
+			c[x] = a[x] ^ a[x+5] ^ a[x+10] ^ a[x+15] ^ a[x+20]
+		}
+		for x := 0; x < 5; x++ {
+			d[x] = c[(x+4)%5] ^ bits.RotateLeft64(c[(x+1)%5], 1)
+		}
+		for i := 0; i < 25; i++ {
+			a[i] ^= d[i%5]
+		}
+		// ρ and π: B[y][(2x+3y) mod 5] = rot(A[x][y])
+		for x := 0; x < 5; x++ {
+			for y := 0; y < 5; y++ {
+				b[y+5*((2*x+3*y)%5)] = bits.RotateLeft64(a[x+5*y], rho[x+5*y])
+			}
+		}
+		// χ
+		for x := 0; x < 5; x++ {
+			for y := 0; y < 5; y++ {
+				a[x+5*y] = b[x+5*y] ^ (^b[(x+1)%5+5*y] & b[(x+2)%5+5*y])
+			}
+		}
+		// ι
+		a[0] ^= rc12[r]
+	}
+}
+
+// turboSHAKE256 is the schedule's incremental TurboSHAKE256 sponge.
+// Its zero value is ready to absorb input.
+type turboSHAKE256 struct {
+	a         [25]uint64
+	off       int
+	squeezing bool
+}
+
+func (t *turboSHAKE256) Write(p []byte) (int, error) {
+	if t.squeezing {
+		panic("tls13dec: Write after Read")
+	}
+	for _, v := range p {
+		t.a[t.off/8] ^= uint64(v) << (8 * uint(t.off%8))
+		t.off++
+		if t.off == turboSHAKE256Rate {
+			keccakP1600x12(&t.a)
+			t.off = 0
+		}
+	}
+	return len(p), nil
+}
+
+func (t *turboSHAKE256) Read(p []byte) (int, error) {
+	if !t.squeezing {
+		// The domain byte and final padding bit share a byte when
+		// the input ends at the last byte of the rate block.
+		t.a[t.off/8] ^= 0x1F << (8 * uint(t.off%8))
+		t.a[(turboSHAKE256Rate-1)/8] ^= 0x80 << (8 * uint((turboSHAKE256Rate-1)%8))
+		keccakP1600x12(&t.a)
+		t.off = 0
+		t.squeezing = true
+	}
+	for i := range p {
+		if t.off == turboSHAKE256Rate {
+			keccakP1600x12(&t.a)
+			t.off = 0
+		}
+		p[i] = byte(t.a[t.off/8] >> (8 * uint(t.off%8)))
+		t.off++
+	}
+	return len(p), nil
+}
+
+func (t *turboSHAKE256) Reset() {
+	*t = turboSHAKE256{}
+}
+
+func (t *turboSHAKE256) clone() xof {
+	c := *t
+	return &c
+}
diff --git a/src/crypto/tls/internal/tls13dec/turboshake_test.go b/src/crypto/tls/internal/tls13dec/turboshake_test.go
