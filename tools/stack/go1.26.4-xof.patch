+
+package tls
+
+import (
+	"crypto/tls/internal/tls13dec"
+	"fmt"
+	"io"
+	"testing"
+)
+
+// TestDecNegotiatedHandshake runs a full TLS 1.3 handshake in which the
+// client offers a XOF KDF in schedule_profile, the server selects it in
+// the cleartext ServerHello, and both sides run the XOF key schedule end to
+// end: the Finished MACs verify (the handshake completes) and application
+// data flows over XOF-derived record keys. It checks both profiles.
+func TestDecNegotiatedHandshake(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		id   uint16
+		prof *tls13dec.Profile
+	}{
+		{"TurboSHAKE256", scheduleTLS13TurboSHAKE256, tls13dec.TurboSHAKE256},
+		{"SHAKE256", scheduleTLS13SHAKE256, tls13dec.SHAKE256},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			clientConfig := testConfig.Clone()
+			clientConfig.MinVersion = VersionTLS13
+			clientConfig.MaxVersion = VersionTLS13
+			clientConfig.scheduleProfiles = []uint16{tc.id}
+
+			serverConfig := testConfig.Clone()
+			serverConfig.MinVersion = VersionTLS13
+			serverConfig.MaxVersion = VersionTLS13
+
+			const msg = "XOF application data"
+			c, s := localPipe(t)
+			errc := make(chan error, 1)
+			go func() {
+				srv := Server(s, serverConfig)
+				if err := srv.Handshake(); err != nil {
+					errc <- fmt.Errorf("server handshake: %w", err)
+					return
+				}
+				if srv.kdf != tc.prof {
+					errc <- fmt.Errorf("server negotiated kdf %v, want %v", srv.kdf, tc.prof)
+					return
+				}
+				if _, err := io.WriteString(srv, msg); err != nil {
+					errc <- fmt.Errorf("server write: %w", err)
+					return
+				}
+				srv.Close()
+				errc <- nil
+			}()
+
+			cli := Client(c, clientConfig)
+			if err := cli.Handshake(); err != nil {
+				t.Fatalf("client handshake: %v", err)
+			}
+			if cli.kdf != tc.prof {
+				t.Errorf("client routed to kdf %v, want %v", cli.kdf, tc.prof)
+			}
+			if v := cli.ConnectionState().Version; v != VersionTLS13 {
+				t.Errorf("version = %x, want TLS 1.3", v)
+			}
+			got, err := io.ReadAll(cli)
+			if err != nil {
+				t.Fatalf("client read: %v", err)
+			}
+			if string(got) != msg {
+				t.Errorf("read %q, want %q", got, msg)
+			}
+			cli.Close()
+			if err := <-errc; err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+// TestHKDFHandshakeUnaffected confirms that a client offering no
+// schedule_profile still runs the RFC 8446 HKDF schedule (nil KDF).
+func TestHKDFHandshakeUnaffected(t *testing.T) {
+	clientConfig := testConfig.Clone()
+	clientConfig.MinVersion = VersionTLS13
+	clientConfig.MaxVersion = VersionTLS13
+	serverConfig := testConfig.Clone()
+	serverConfig.MinVersion = VersionTLS13
+	serverConfig.MaxVersion = VersionTLS13
+
+	const msg = "hkdf application data"
+	c, s := localPipe(t)
+	errc := make(chan error, 1)
+	go func() {
+		srv := Server(s, serverConfig)
+		if err := srv.Handshake(); err != nil {
+			errc <- fmt.Errorf("server handshake: %w", err)
+			return
+		}
+		if srv.kdf != nil {
+			errc <- fmt.Errorf("server kdf = %v, want nil (HKDF)", srv.kdf)
+			return
+		}
+		io.WriteString(srv, msg)
+		srv.Close()
+		errc <- nil
+	}()
+
+	cli := Client(c, clientConfig)
+	if err := cli.Handshake(); err != nil {
+		t.Fatalf("client handshake: %v", err)
+	}
+	if cli.kdf != nil {
+		t.Errorf("client kdf = %v, want nil (HKDF)", cli.kdf)
+	}
+	got, _ := io.ReadAll(cli)
+	if string(got) != msg {
+		t.Errorf("read %q, want %q", got, msg)
+	}
+	cli.Close()
+	if err := <-errc; err != nil {
+		t.Fatal(err)
+	}
+}
